def research_index():
    rs = [o for _, o, _ in merged() if o['kind'] == 'research']
    byrec = {}
    for o in rs:
        byrec[(o.get('data') or {}).get('record')] = o
        for al in o.get('aliases', []): byrec.setdefault(al, o)
    return rs, byrec
def chain_of(o, byrec):
    """Every research that must be finished before o (transitive), each once, nearest first; plus other required records (buildings) by name."""
    seen = {}; other = []; queue = [o]
    while queue:
        cur = queue.pop(0)
        for q in (cur.get('data') or {}).get('requires', []):
            if q['kind'] == 'research' and q['id'] in byrec:
                x = byrec[q['id']]
                if x['id'] not in seen and x['id'] != o['id']: seen[x['id']] = x; queue.append(x)
            elif q['kind'] != 'research' and q['name'] not in other: other.append(q['name'])
    return list(seen.values()), other
