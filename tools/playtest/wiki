        if e['id'] in existing: fn = existing[e['id']]
        else: fn = {'zone': 'zones', 'quiet-spot': 'zones', 'spawn': 'zones', 'town': 'towns', 'camp': 'towns', 'bandit-hq': 'towns', 'shop': 'towns', 'npc': 'npcs', 'character': 'characters', 'faction': 'factions', 'note': 'notes'}.get(e['kind'], 'items')
        p = os.path.join(folder, fn + '.json')
