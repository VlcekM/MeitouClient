<Project>

  <!-- Local vendor binaries stay outside source control; both executable projects need the same runtime. Each one present is copied: Streamline
       for DLSS, amd_fidelityfx_vk.dll for FSR (the release zips fetch them in tools/scripts/package-release.ps1). -->
  <PropertyGroup>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_DLSS_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_STREAMLINE_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MSBuildThisFileDirectory)dlss-runtime</StreamlineRuntimePath>
  </PropertyGroup>

  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-')))">
    <!-- Wildcards, so only the files present are listed. -->
    <None Include="$(StreamlineRuntimePath)/sl.*.dll;$(StreamlineRuntimePath)/nvngx_dlss*.dll;$(StreamlineRuntimePath)/NvLowLatencyVk*.dll;$(StreamlineRuntimePath)/amd_fidelityfx_vk*.dll"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Linux: the DLSS model and NGX's client library (libmeitou_ngx.so, tools/scripts/build-ngx-shim.sh) for Ngx.cs, the model in any version. -->
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and Exists('$(StreamlineRuntimePath)') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux-')))">
    <None Include="$(StreamlineRuntimePath)/libnvidia-ngx-dlss.so.*;$(StreamlineRuntimePath)/libmeitou_ngx*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Linux: FSR's libamd_fidelityfx_vk.so, built by tools/scripts/build-ffx-linux.sh (AMD ships none); release zips build their own. -->
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and $([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64')">
    <None Include="$(StreamlineRuntimePath)/libamd_fidelityfx_vk*.so"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
