<Project>

  <!-- Meitou's analyzers (analyzers/Meitou.Analyzers) check the projects whose texts .github/scripts/loc-strings.mjs reads: MEI0001 fails the
       build on a player-facing $"..." text that locale/meitou.built does not list, MEI0002 on a text a built-in catalog cannot translate.
       Built for the host, whatever the project's runtime. -->
  <PropertyGroup>
    <MeitouTextChecked>false</MeitouTextChecked>
    <MeitouTextChecked Condition="$([System.String]::Copy(';Meitou.Core;Meitou.Data;Meitou.Simulation;Meitou.Game;Meitou.Launcher;').Contains(';$(MSBuildProjectName);'))">true</MeitouTextChecked>
  </PropertyGroup>
  <ItemGroup Condition="'$(MeitouTextChecked)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/Meitou.Analyzers/Meitou.Analyzers.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;MeitouLegacyMac;MeitouTargetFramework" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Meitou.Core/Localisation/locale/meitou.built" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Meitou.Core/Localisation/locale/meitou.ignore" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Meitou.Core/Localisation/locale/*.po" />
    <AdditionalFiles Include="**/*.axaml" Exclude="bin/**;obj/**" Condition="'$(MSBuildProjectName)' == 'Meitou.Launcher'" />
  </ItemGroup>

  <!-- The public API check (Directory.Build.props): the baseline is the release's own reference assembly and the libraries beside it in
       Meitou.References, downloaded, never referenced (its build/ targets would put the old assemblies into the build). -->
  <ItemGroup Condition="'$(ApiCompatValidateAssemblies)' == 'true'">
    <PackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100" PrivateAssets="all" />
    <PackageDownload Include="Meitou.References" Version="[$(MeitouApiBaseline)]" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ApiCompatValidateAssemblies)' == 'true'">
    <MeitouApiBaselineDirectory>$(NuGetPackageRoot)meitou.references/$(MeitouApiBaseline)/assemblies/$(TargetFramework)/ref/</MeitouApiBaselineDirectory>
    <ApiCompatContractAssembly>$(MeitouApiBaselineDirectory)$(AssemblyName).dll</ApiCompatContractAssembly>
    <ApiCompatUseImplementationReferencesForContract>false</ApiCompatUseImplementationReferencesForContract>
  </PropertyGroup>
  <!-- The baseline resolves its references in its own package (its other Meitou assemblies, as released) and the framework. -->
  <Target Name="MeitouApiBaselineReferences" AfterTargets="GetReferencesForApiCompatValidateAssemblies"
          Condition="'$(ApiCompatValidateAssemblies)' == 'true'">
    <ItemGroup>
      <ApiCompatContractAssemblyReferences Include="$(MeitouApiBaselineDirectory)" />
      <ApiCompatContractAssemblyReferences Include="@(ReferencePathWithRefAssemblies)"
                                           Condition="'%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
  </Target>

  <!-- The packaged macOS OpenAL and GLFW binaries require Sonoma. CI builds the same versions for Ventura. -->
  <PropertyGroup>
    <MeitouMacNativeDirectory>$(MSBuildThisFileDirectory)macos-runtime/$(RuntimeIdentifier)</MeitouMacNativeDirectory>
  </PropertyGroup>
  <Target Name="UseMacNativeLibraries" AfterTargets="ResolvePackageAssets" BeforeTargets="EmbedNativeLibraries"
          Condition="'$(MeitouLegacyMac)' == 'true' and $(RuntimeIdentifier.StartsWith('osx-')) and Exists('$(MeitouMacNativeDirectory)')">
    <ItemGroup>
      <_MacNativeReplacement Include="@(NativeCopyLocalItems)"
                             Condition="Exists('$(MeitouMacNativeDirectory)/%(Filename)%(Extension)')" />
      <NativeCopyLocalItems Remove="@(_MacNativeReplacement)" />
      <NativeCopyLocalItems Include="@(_MacNativeReplacement->'$(MeitouMacNativeDirectory)/%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- Local vendor binaries stay outside source control; both executable projects need the same runtime. Each one present is copied: Streamline
       for DLSS, amd_fidelityfx_vk.dll for FSR (the release zips fetch them in tools/scripts/package-release.ps1). -->
  <PropertyGroup>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_DLSS_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MEITOU_STREAMLINE_PATH)</StreamlineRuntimePath>
    <StreamlineRuntimePath Condition="'$(StreamlineRuntimePath)' == ''">$(MSBuildThisFileDirectory)dlss-runtime</StreamlineRuntimePath>
  </PropertyGroup>

  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win-')))">
    <!-- Wildcards, so only the files present are listed. -->
    <None Include="$(StreamlineRuntimePath)/sl.*.dll;$(StreamlineRuntimePath)/nvngx_dlss*.dll;$(StreamlineRuntimePath)/meitou_ngx*.dll;$(StreamlineRuntimePath)/NvLowLatencyVk*.dll;$(StreamlineRuntimePath)/amd_fidelityfx_vk*.dll"
          Link="Native/%(Filename)%(Extension)" TargetPath="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Linux: the DLSS model and NGX's client library (libmeitou_ngx.so, tools/scripts/build-ngx-shim.sh) for Ngx.cs, the model in any version,
       and our Linux build of the FidelityFX library (libamd_fidelityfx_vk.so, with AMD's licence text) for FSR and frame generation. -->
  <ItemGroup Condition="('$(MSBuildProjectName)' == 'Meitou.Game' or '$(MSBuildProjectName)' == 'Meitou.ModelViewer') and Exists('$(StreamlineRuntimePath)') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux-')))">
    <None Include="$(StreamlineRuntimePath)/libnvidia-ngx-dlss.so.*;$(StreamlineRuntimePath)/libmeitou_ngx*.so;$(StreamlineRuntimePath)/libamd_fidelityfx_vk*.so;$(StreamlineRuntimePath)/LICENSE-FidelityFX*.txt" Link="Native/%(Filename)%(Extension)"
         TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
