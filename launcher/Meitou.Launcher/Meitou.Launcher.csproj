<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Meitou launcher: installs game releases from GitHub, edits the mod list (data/mods.cfg) and starts the game. docs/launcher.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>meitou-launcher</AssemblyName>
    <RootNamespace>Meitou.Launcher</RootNamespace>
    <!-- The newest launcher/CHANGELOG.md section's version, so local builds match the latest release; the release workflow passes -p:Version. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CHANGELOG.md')), '(?m)^## v(\S+)').Groups[1].Value)</Version>
    <ApplicationIcon>../../assets/branding/meitou.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Published as one Native AOT executable: the native libraries are embedded (below, NativeLibraries.cs), symbols stay out. -->
    <PublishAot>true</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/branding/meitou.ico" Link="Assets/meitou.ico" />
    <AvaloniaResource Include="../../assets/branding/meitou-64.png" Link="Assets/meitou-64.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Meitou.Core\Meitou.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="NVorbis" Version="1.0.0-alpha.2" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <!-- News videos: libvpx from vcpkg (`vcpkg install libvpx:<triplet>`), its installed/<triplet> folder at VpxRoot (default: the git-ignored
       vpx-runtime/<triplet> at the repository root). A publish links the static library into the executable; Debug builds copy the DLL.
       Without it the launcher builds and leaves videos out (docs/launcher.md, "News"). -->
  <PropertyGroup>
    <VpxTriplet Condition="'$(VpxTriplet)' == '' and '$(RuntimeIdentifier)' == 'win-x64'">x64-windows-static</VpxTriplet>
    <VpxTriplet Condition="'$(VpxTriplet)' == '' and '$(RuntimeIdentifier)' == 'linux-x64'">x64-linux</VpxTriplet>
    <VpxTriplet Condition="'$(VpxTriplet)' == '' and '$(RuntimeIdentifier)' == 'osx-x64'">x64-osx</VpxTriplet>
    <VpxTriplet Condition="'$(VpxTriplet)' == '' and '$(RuntimeIdentifier)' == 'osx-arm64'">arm64-osx</VpxTriplet>
    <VpxTriplet Condition="'$(VpxTriplet)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">x64-windows</VpxTriplet>
    <VpxRoot Condition="'$(VpxRoot)' == ''">$(MSBuildThisFileDirectory)../../vpx-runtime/$(VpxTriplet)</VpxRoot>
    <VpxStatic Condition="Exists('$(VpxRoot)/lib/vpx.lib')">$(VpxRoot)/lib/vpx.lib</VpxStatic>
    <VpxStatic Condition="Exists('$(VpxRoot)/lib/libvpx.a')">$(VpxRoot)/lib/libvpx.a</VpxStatic>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(VpxStatic)' != ''">
    <DirectPInvoke Include="vpx" />
    <NativeLibrary Include="$(VpxStatic)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="$(VpxRoot)/bin/vpx*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- On publish, the runtime's native libraries (Skia, HarfBuzz, ANGLE) go into the executable as native/<file> resources instead of next to it.
       Their names and hashes go in as the NativeLibraries metadata, so the launcher names their folder without hashing them at startup. -->
  <Target Name="EmbedNativeLibraries" AfterTargets="ResolvePackageAssets" Condition="'$(_IsPublishing)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_NativeToEmbed Include="@(NativeCopyLocalItems)" Condition="'%(Extension)' != '.pdb' and '%(Extension)' != '.dbg'" />
      <EmbeddedResource Include="@(_NativeToEmbed)" LogicalName="native/%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
    <GetFileHash Files="@(_NativeToEmbed)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_NativeHashed" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>NativeLibraries</_Parameter1>
        <_Parameter2>@(_NativeHashed->'%(Filename)%(Extension)=%(FileHash)', ';')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Target Name="UnpublishNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(_IsPublishing)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
