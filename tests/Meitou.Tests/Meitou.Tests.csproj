<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meitou.Core\Meitou.Core.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Data\Meitou.Data.csproj" />
    <ProjectReference Include="../../src/Meitou.Ui/Meitou.Ui.csproj" />
    <ProjectReference Include="../../src/Meitou.Game/Meitou.Game.csproj" />
    <ProjectReference Include="../../src/Meitou.Modding/Meitou.Modding.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Engine\Meitou.Engine.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Rendering\Meitou.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Simulation\Meitou.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Navigation\Meitou.Navigation.csproj" />
    <ProjectReference Include="..\..\src\Meitou.Audio\Meitou.Audio.csproj" />
    <!-- The Metal backend is macOS-only (SharpMetal); the Metal tests are compiled only there. -->
    <ProjectReference Include="../../src/Meitou.Metal/Meitou.Metal.csproj" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);MEITOU_METAL</DefineConstants>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
