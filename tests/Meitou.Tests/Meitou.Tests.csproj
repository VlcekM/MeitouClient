<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game brings the simulation, Data and Core with it. -->
    <ProjectReference Include="../../src/Meitou.Game/Meitou.Game.csproj" />
  </ItemGroup>

  <!-- The Metal tests compile where the game's Metal backend does (MeitouMetal, Directory.Build.props). -->
  <PropertyGroup Condition="'$(MeitouMetal)' == 'true'">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
