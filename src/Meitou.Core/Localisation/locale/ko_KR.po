msgstr "공유"

msgid "Sharp zone"
msgstr "선명 구역"

msgid "Sharpen the image after resolution reconstruction."
msgstr "해상도 재구성 후 이미지를 선명하게 합니다."

msgid "Shift dark scenes toward the blue of night vision."
msgstr "어두운 장면을 야간 시력의 푸른빛으로 옮깁니다."

msgid "Shift pan boost"
msgstr "Shift 이동 가속"

msgid "Shift pan speed"
msgstr "Shift 이동 속도"

msgid "Short sharp sun shadows where small things touch a surface."
msgstr "작은 물체가 표면에 닿는 곳의 짧고 선명한 태양 그림자."

msgid "Shoulder"
msgstr "어깨"

