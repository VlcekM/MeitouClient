msgstr "식생 가시성을 레이어가 아닌 메시 크기로 정합니다."

msgid "Set the Kenshi folder first (Settings)."
msgstr "먼저 Kenshi 폴더를 지정하세요(설정)."

msgid "Set the Kenshi folder in Settings to list its mods."
msgstr "모드를 나열하려면 설정에서 Kenshi 폴더를 지정하세요."

msgid "Set up Meitou"
msgstr "Meitou 설정"

msgid "Sets the upscaler and the render scale. MetalFX temporal by default; spatial is an alternative."
msgstr "업스케일러와 렌더링 배율을 설정합니다. 기본은 MetalFX 시간, 공간은 대안입니다."

msgid "Settings"
msgstr "설정"

msgid "Settings   (Tab hides this)"
msgstr "설정   (Tab으로 숨김)"

msgid "Setup"
msgstr "설정"

msgid "Sfx volume"
msgstr "효과음 음량"

msgid "Shadow"
msgstr "그림자"

msgid "Shadow cascades"
msgstr "그림자 캐스케이드"

msgid "Shadow cascades (Meitou)"
msgstr "그림자 캐스케이드 (Meitou)"

msgid "Shadow distance"
msgstr "그림자 거리"

msgid "Shadow distance (game 1k-9k, 0 off)"
msgstr "그림자 거리 (게임 1k-9k, 0 끔)"

msgid "Shadow filter"
msgstr "그림자 필터"

