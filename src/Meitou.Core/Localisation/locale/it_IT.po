msgstr "Celle di sangue"

msgid "Blood decals drawn"
msgstr "Decal di sangue disegnate"

msgid "Blood on surfaces"
msgstr "Sangue sulle superfici"

msgid "Blood on weapons and gear"
msgstr "Sangue su armi ed equipaggiamento"

msgid "Bloody footprints"
msgstr "Impronte insanguinate"

msgid "Bloom"
msgstr "Bloom"

msgid "Bloom strength"
