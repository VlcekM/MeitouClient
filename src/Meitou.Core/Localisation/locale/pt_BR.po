msgstr "Volume da interface"

msgid "VO volume"
msgstr "Volume das vozes"

msgid "Volume of combat, building and other sound effects."
msgstr "Volume dos sons de combate, construção e outros efeitos sonoros."

msgid "Attackers per target"
msgstr "Atacantes por alvo"

msgid "Default settings restored."
msgstr "Configurações padrão restauradas."

msgid "That key is reserved. Choose another key, or Esc to cancel."
msgstr "Essa tecla é reservada. Escolha outra tecla ou pressione Esc para cancelar."

msgid "Enter a valid number, or press Esc to cancel."
msgstr "Digite um número válido ou pressione Esc para cancelar."

msgid "Low quality applied."
msgstr "Qualidade baixa aplicada."

msgid "Medium quality applied."
msgstr "Qualidade média aplicada."

msgid "High quality applied."
msgstr "Qualidade alta aplicada."

msgid "Ultra quality applied."
msgstr "Qualidade ultra aplicada."

msgid "Every graphics feature is Meitou."
msgstr "Todos os recursos gráficos estão no modo Meitou."

msgid "Every graphics feature is as the game ships it."
msgstr "Todos os recursos gráficos estão como na versão original do jogo."

msgid "Every gameplay change is Meitou."
msgstr "Todas as alterações de jogabilidade estão no modo Meitou."

msgid "Every gameplay change is as the game ships it."
msgstr "Todas as alterações de jogabilidade estão como na versão original do jogo."

msgid "Every fix is Meitou."
msgstr "Todas as correções estão ativadas."

msgid "Every fix is as the game ships it."
msgstr "Todas as correções estão desativadas, como na versão original do jogo."

