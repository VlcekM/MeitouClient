<Project Sdk="Microsoft.NET.Sdk">

  <!-- The code-mod contract (IMod, ModContext, IModSaveData) and the loader the game runs it with (docs/modding.md). Mods compile against it. -->

  <ItemGroup>
    <ProjectReference Include="../Meitou.Core/Meitou.Core.csproj" />
    <ProjectReference Include="../Meitou.Data/Meitou.Data.csproj" />
    <ProjectReference Include="../Meitou.Simulation/Meitou.Simulation.csproj" />
    <ProjectReference Include="../Meitou.Ui/Meitou.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one Harmony every mod patches through (docs/modding.md "Loading"): 0Harmony.dll with MonoMod merged in, loaded by the game. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meitou.Tests" />
  </ItemGroup>

</Project>
