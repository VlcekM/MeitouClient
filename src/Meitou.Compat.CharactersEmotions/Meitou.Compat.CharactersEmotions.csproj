<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The native port of the Workshop plugin mod "Characters Emotions" (docs/compat-characters-emotions.md): a Meitou code mod shipped in the game's compat folder, loaded
    when CharactersEmotions.mod is enabled. The game supplies every Meitou assembly (Private=false), so the output is this one DLL.
  -->

  <PropertyGroup>
    <RootNamespace>Meitou.Compat.CharactersEmotions</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Against the game's built assemblies, which the game's own build passes in (GameBin): the mod API is in MeitouClient.dll, and the game builds this project after itself. -->
  <PropertyGroup>
    <GameBin Condition="'$(GameBin)' == ''">../Meitou.Game/bin/$(Configuration)/net10.0</GameBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MeitouClient" HintPath="$(GameBin)/MeitouClient.dll" Private="false" />
    <Reference Include="Meitou.Core" HintPath="$(GameBin)/Meitou.Core.dll" Private="false" />
    <Reference Include="Meitou.Data" HintPath="$(GameBin)/Meitou.Data.dll" Private="false" />
    <Reference Include="Meitou.Simulation" HintPath="$(GameBin)/Meitou.Simulation.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
