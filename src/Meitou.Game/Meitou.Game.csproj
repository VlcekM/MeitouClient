<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game executable: boots into the world with the Kenshi camera (docs/engine.md). -->

  <PropertyGroup>
    <!-- Windowed: no console window opens with the game; a terminal that starts it still gets its output (GameConsole). -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeitouClient</AssemblyName>
    <ApplicationIcon>../../assets/branding/meitou.ico</ApplicationIcon>
    <RootNamespace>Meitou.Game</RootNamespace>
    <!-- Tiered PGO re-JITs hot render code for minutes; each install suspends the runtime and stalled frames 10-20 ms (DECISIONS 11). -->
    <TieredPGO>false</TieredPGO>
    <!-- No tiering at all: methods are compiled once, fully optimised. Tier-up recompiles of the render and streaming code kept landing in frames as 2-11 ms stalls; loading is no slower (DECISIONS 19). -->
    <TieredCompilation>false</TieredCompilation>
    <!-- Server GC on four heaps: the streaming threads allocate ~2 MB a frame, and single-threaded gen0 GCs over the ~0.5 GB gen2 paused every thread 3-15 ms (DECISIONS 19). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Meitou.Localisation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meitou.Audio\Meitou.Audio.csproj" />
    <ProjectReference Include="..\Meitou.Core\Meitou.Core.csproj" />
    <ProjectReference Include="..\Meitou.Data\Meitou.Data.csproj" />
    <ProjectReference Include="../Meitou.Ui/Meitou.Ui.csproj" />
    <ProjectReference Include="..\Meitou.Engine\Meitou.Engine.csproj" />
    <ProjectReference Include="../Meitou.Navigation/Meitou.Navigation.csproj" />
    <ProjectReference Include="..\Meitou.Rendering\Meitou.Rendering.csproj" />
    <ProjectReference Include="..\Meitou.Rendering.Display\Meitou.Rendering.Display.csproj" />
    <!-- The Metal backend (macOS only: SharpMetal P/Invokes /usr/lib/libobjc.A.dylib), so the Windows build never sees it. -->
    <ProjectReference Include="..\Meitou.Metal\Meitou.Metal.csproj" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);MEITOU_METAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="4" />
    <!-- GC threads not pinned to CPUs 0-3 (HeapCount pins them by default): a pinned thread waiting for its busy core stalled 1 in ~40 collections 100-290 ms (docs/engine.md "GC"). -->
    <RuntimeHostConfigurationOption Include="System.GC.NoAffinitize" Value="true" />
    <!-- Gen0 budget at most 16 MB: the default let ~1 GB pile up between collections, and each gen0/gen1 paused every thread 20-190 ms (docs/engine.md "GC"). -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="16777216" />
    <!-- The Meitou title's wordmark (TitleLogo). -->
    <EmbeddedResource Include="../../assets/branding/kenshi-logo.png" LogicalName="kenshi-logo.png" />
    <!-- The picture under the luckyren Mode setting (SettingsMenuArt). -->
    <EmbeddedResource Include="../../assets/luckyren-mode.png" LogicalName="luckyren-mode.png" />
  </ItemGroup>

  <Target Name="ReadBuildRevision" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="'$(BuildGitCommit)' == ''">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildGitCommitExit" />
    </Exec>
    <Exec Command="git describe --tags --abbrev=0" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="'$(BuildGitTag)' == ''">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildGitTag" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildGitTagExit" />
    </Exec>
    <PropertyGroup>
      <BuildGitCommit Condition="'$(BuildGitCommit)' == '' and '$(_BuildGitCommitExit)' == '0'">@(_BuildGitCommit)</BuildGitCommit>
      <BuildGitTag Condition="'$(BuildGitTag)' == '' and '$(_BuildGitTagExit)' == '0'">@(_BuildGitTag)</BuildGitTag>
      <BuildGitCommit Condition="'$(BuildGitCommit)' == ''">unknown commit</BuildGitCommit>
      <BuildGitTag Condition="'$(BuildGitTag)' == ''">untagged</BuildGitTag>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommit</_Parameter1>
        <_Parameter2>$(BuildGitCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitTag</_Parameter1>
        <_Parameter2>$(BuildGitTag)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
