<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game executable: boots into the world with the Kenshi camera (docs/engine.md). Everything the player sees, hears and touches lives here:
       the host (Host/), the renderers and their GPU layer (Rendering/: Gpu/ the Vulkan device and shader compiler, Display/ the window, Upscalers/
       FSR and DLSS, Metal/ the macOS backend; docs/renderer-native.md), audio (Audio/), the MyGUI host (Ui/) and the code-mod loader (Mods/,
       docs/modding.md). The simulation below it never references this project. -->

  <PropertyGroup>
    <!-- Windowed: no console window opens with the game; a terminal that starts it still gets its output (GameConsole). -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeitouClient</AssemblyName>
    <ApplicationIcon>../../assets/branding/meitou.ico</ApplicationIcon>
    <RootNamespace>Meitou.Game</RootNamespace>
    <!-- Tiered PGO re-JITs hot render code for minutes; each install suspends the runtime and stalled frames 10-20 ms (DECISIONS 11). -->
    <TieredPGO>false</TieredPGO>
    <!-- No tiering at all: methods are compiled once, fully optimised. Tier-up recompiles of the render and streaming code kept landing in frames as 2-11 ms stalls; loading is no slower (DECISIONS 19). -->
    <TieredCompilation>false</TieredCompilation>
    <!-- Server GC on four heaps: the streaming threads allocate ~2 MB a frame, and single-threaded gen0 GCs over the ~0.5 GB gen2 paused every thread 3-15 ms (DECISIONS 19). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Meitou.Localisation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <!-- The one Harmony every code mod patches through (docs/modding.md "Loading"): 0Harmony.dll with MonoMod merged in. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

  <!-- The Metal backend (Rendering/Metal): the engine's GLSL through shaderc to SPIR-V and spirv-cross to MSL; compiled where MeitouMetal is set
       (Directory.Build.props: macOS), so the Windows build never sees SharpMetal. -->
  <ItemGroup Condition="'$(MeitouMetal)' == 'true'">
    <PackageReference Include="SharpMetal" Version="1.1.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <EmbeddedResource Include="Rendering/Metal/Gi/ProbeGi.metal" LogicalName="Meitou.Metal.Gi.ProbeGi.metal" />
  </ItemGroup>
  <ItemGroup Condition="'$(MeitouMetal)' != 'true'">
    <Compile Remove="Rendering/Metal/**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MeitouMetal)' == 'true'">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meitou.Core\Meitou.Core.csproj" />
    <ProjectReference Include="..\Meitou.Data\Meitou.Data.csproj" />
    <ProjectReference Include="..\Meitou.Simulation\Meitou.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="4" />
    <!-- GC threads not pinned to CPUs 0-3 (HeapCount pins them by default): a pinned thread waiting for its busy core stalled 1 in ~40 collections 100-290 ms (docs/engine.md "GC"). -->
    <RuntimeHostConfigurationOption Include="System.GC.NoAffinitize" Value="true" />
    <!-- Gen0 budget at most 16 MB: the default let ~1 GB pile up between collections, and each gen0/gen1 paused every thread 20-190 ms (docs/engine.md "GC"). -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="16777216" />
    <!-- The window icon: the two moons, 256 x 256 raw RGBA (assets/branding). -->
    <EmbeddedResource Include="../../assets/branding/meitou-256.rgba" LogicalName="meitou-256.rgba" Link="Assets/meitou-256.rgba" />
    <!-- The Meitou title's wordmark (TitleLogo). -->
    <EmbeddedResource Include="../../assets/branding/kenshi-logo.png" LogicalName="kenshi-logo.png" Link="Assets/kenshi-logo.png" />
    <!-- The picture under the luckyren Mode setting (SettingsMenuArt). -->
    <EmbeddedResource Include="../../assets/luckyren-mode.png" LogicalName="luckyren-mode.png" Link="Assets/luckyren-mode.png" />
    <!-- How soft each ground texture is, for the ground trails (GroundSoftness). -->
    <EmbeddedResource Include="../../assets/ground-softness.cfg" LogicalName="ground-softness.cfg" Link="Assets/ground-softness.cfg" />
  </ItemGroup>

  <Target Name="ReadBuildRevision" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="'$(BuildGitCommit)' == ''">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildGitCommitExit" />
    </Exec>
    <!-- Game tags only (v*): a launcher-v* tag is not a game version, and code mods' gameVersion ranges read this (docs/modding-dependencies.md). -->
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="Low" StandardErrorImportance="Low" Condition="'$(BuildGitTag)' == ''">
      <Output TaskParameter="ConsoleOutput" ItemName="_BuildGitTag" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildGitTagExit" />
    </Exec>
    <PropertyGroup>
      <BuildGitCommit Condition="'$(BuildGitCommit)' == '' and '$(_BuildGitCommitExit)' == '0'">@(_BuildGitCommit)</BuildGitCommit>
      <BuildGitTag Condition="'$(BuildGitTag)' == '' and '$(_BuildGitTagExit)' == '0'">@(_BuildGitTag)</BuildGitTag>
      <BuildGitCommit Condition="'$(BuildGitCommit)' == ''">unknown commit</BuildGitCommit>
      <BuildGitTag Condition="'$(BuildGitTag)' == ''">untagged</BuildGitTag>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommit</_Parameter1>
        <_Parameter2>$(BuildGitCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitTag</_Parameter1>
        <_Parameter2>$(BuildGitTag)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The bundled port of an RE_Kenshi plugin mod (docs/modding.md "Ports"), beside the game under compat/CharactersEmotions (ModHost.BundledPorts): built after the game, against its assemblies, since the mod API is in MeitouClient.dll. -->
  <Target Name="BundledPort" AfterTargets="Build"
          Inputs="@(BundledPortSource)" Outputs="$(TargetDir)compat/CharactersEmotions/Meitou.Compat.CharactersEmotions.dll">
    <Exec Command="dotnet build &quot;../Meitou.Compat.CharactersEmotions/Meitou.Compat.CharactersEmotions.csproj&quot; -c $(Configuration) -p:GameBin=&quot;$(TargetDir.TrimEnd('\'))&quot; -p:NuGetAudit=false -o &quot;$(TargetDir)compat/CharactersEmotions&quot; -v q" />
  </Target>
  <Target Name="BundledPortPublish" AfterTargets="Publish">
    <ItemGroup>
      <BundledPortFile Include="$(TargetDir)compat/CharactersEmotions/*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledPortFile)" DestinationFolder="$(PublishDir)compat/CharactersEmotions" />
  </Target>
  <ItemGroup>
    <BundledPortSource Include="../Meitou.Compat.CharactersEmotions/*.cs;../Meitou.Compat.CharactersEmotions/*.csproj;../Meitou.Compat.CharactersEmotions/meitou.json;Mods/*.cs" />
  </ItemGroup>

</Project>
