<Project>
  <!--
    LayoutCodeHash: a hash of the SOURCE of what the foliage layout runs on (Meitou.Data and Meitou.Core, the only Meitou project it references: every .cs file
    and the two project files, line endings normalised, sorted by path relative to src), generated at build time into obj as Meitou.Data.World.LayoutCodeHash.Value.
    The foliage layout cache (FoliageLayoutCache.ComputeKey) uses it instead of the assemblies' module ids, which differ between worktrees and with any unrelated rebuild.
    Same sources, same hash, whatever the directory or the build.
  -->
  <UsingTask TaskName="HashLayoutSources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Root ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string root = Path.GetFullPath(Root);
        var entries = Files.Select(f => Path.GetFullPath(f.ItemSpec))
            .Select(full => (Rel: full.Substring(root.Length).TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).Replace(Path.DirectorySeparatorChar, '/'), Full: full))
            .OrderBy(e => e.Rel, StringComparer.Ordinal).ToList();
        using var sha = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
        foreach (var e in entries)
        {
            var bytes = File.ReadAllBytes(e.Full);
            int start = bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF ? 3 : 0;
            var normal = new MemoryStream(bytes.Length);
            for (int i = start; i < bytes.Length; i++)
                if (!(bytes[i] == (byte)'\r' && i + 1 < bytes.Length && bytes[i + 1] == (byte)'\n')) normal.WriteByte(bytes[i]);
            sha.AppendData(Encoding.UTF8.GetBytes(e.Rel + "\n" + normal.Length + "\n"));
            sha.AppendData(normal.ToArray());
        }
        string hex = BitConverter.ToString(sha.GetHashAndReset()).Replace("-", "").ToLowerInvariant();
        string code = "// <auto-generated> by LayoutCodeHash.targets </auto-generated>\nnamespace Meitou.Data.World;\n\n"
            + "/// <summary>Hash of the source of the foliage layout's code (Meitou.Data and Meitou.Core), computed at build time.</summary>\n"
            + "public static class LayoutCodeHash\n{\n    public const string Value = \"" + hex + "\";\n    public const int Files = " + entries.Count + ";\n}\n";
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != code)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, code);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateLayoutCodeHash" BeforeTargets="CoreCompile;BeforeCompile" DependsOnTargets="PrepareForBuild">
    <PropertyGroup>
      <LayoutHashRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</LayoutHashRoot>
      <LayoutHashFile>$(IntermediateOutputPath)LayoutCodeHash.g.cs</LayoutHashFile>
    </PropertyGroup>
    <ItemGroup>
      <LayoutHashSource Include="$(MSBuildThisFileDirectory)**/*.cs;$(MSBuildThisFileDirectory)Meitou.Data.csproj;$(LayoutHashRoot)/Meitou.Core/**/*.cs;$(LayoutHashRoot)/Meitou.Core/Meitou.Core.csproj"
                         Exclude="$(MSBuildThisFileDirectory)obj/**;$(MSBuildThisFileDirectory)bin/**;$(LayoutHashRoot)/Meitou.Core/obj/**;$(LayoutHashRoot)/Meitou.Core/bin/**" />
    </ItemGroup>
    <HashLayoutSources Files="@(LayoutHashSource)" Root="$(LayoutHashRoot)" OutputFile="$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(LayoutHashFile)))" />
    <ItemGroup>
      <Compile Remove="$(LayoutHashFile)" />
      <Compile Include="$(LayoutHashFile)" />
      <FileWrites Include="$(LayoutHashFile)" />
    </ItemGroup>
  </Target>
</Project>
