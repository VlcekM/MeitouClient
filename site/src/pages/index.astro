---
import Base from '../layouts/Base.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import GithubIcon from '../components/GithubIcon.astro';
import WindowsIcon from '../components/WindowsIcon.astro';
import LinuxIcon from '../components/LinuxIcon.astro';
import AppleIcon from '../components/AppleIcon.astro';

// The launcher's setup per platform, as named on its launcher-v* releases (.github/workflows/launcher-release.yml).
const releasesPage = 'https://github.com/VlcekM/MeitouClient/releases';
const platforms = [
  { os: 'windows', name: 'Windows', Icon: WindowsIcon, asset: 'MeitouLauncher-win-x64-Setup.exe', file: 'Setup .exe' },
  { os: 'linux', name: 'Linux', Icon: LinuxIcon, asset: 'MeitouLauncher-linux-x64.AppImage', file: 'AppImage' },
  {
    os: 'macos', name: 'macOS', Icon: AppleIcon, asset: 'MeitouLauncher-osx-arm64-Setup.pkg', file: 'Apple silicon .pkg',
    alt: { asset: 'MeitouLauncher-osx-x64-Setup.pkg', label: 'Intel Mac' },
  },
];

const trailer = 'https://www.youtube.com/watch?v=qm722zwWnJU';

// The performance video: 30 fps WebM, no audio.
const performanceVideo = '/fast-loading.webm';

// Before/after pairs for the comparison slider: Faithful on the left, Meitou on the right.
const pairs = [
  { name: 'Lighting', before: '/compare/lighting-before.webp', after: '/compare/lighting-after.webp' },
  { name: 'Render distance', before: '/compare/distance-before.webp', after: '/compare/distance-after.webp' },
  { name: 'Weather', before: '/compare/weather-before.webp', after: '/compare/weather-after.webp' },
];
---
<Base title="MeitouClient - Kenshi engine reimplementation" video>
  <section class="hero">
    <div class="stack">
      <h1>Run Kenshi on a new engine</h1>
      <p class="lede">
        <span class="name">Meitou<span>Client</span></span> is an open-source reimplementation of the Kenshi engine.
        Fully compatible with FCS mods and vanilla save games. Requires original copy to run
      </p>
    </div>
    <a class="trailer" href={trailer} target="_blank" rel="noopener">
      <span class="trailer-disc" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="36" height="36"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
      </span>
      <span class="trailer-label">View trailer</span>
    </a>
    <div class="actions">
      <a class="mt-btn mt-btn-primary" href={releasesPage} data-download>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-5-5m5 5l5-5M5 20h14" /></svg>
        <span>Download</span>
      </a>
      <a class="mt-btn more" href="#ai">
        <svg class="more-icon" viewBox="0 0 24 20" width="24" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 5l5 5-5 5"/></svg>
        <span>Learn More</span>
      </a>
    </div>
  </section>

  <dialog class="dl mt-plate" aria-labelledby="dl-title">
    <form method="dialog"><button class="dl-close" aria-label="Close">&times;</button></form>
    <h2 id="dl-title">Download the launcher</h2>
    <p class="dl-sub">It installs and updates MeitouClient for you. You need Kenshi installed. <span class="dl-version"></span></p>
    <div class="dl-choices">
      {platforms.map((p) => (
        <div class="dl-choice" data-os={p.os}>
          <a class="dl-main" href={releasesPage} data-asset={p.asset}>
            <p.Icon />
            <span class="dl-name">{p.name}</span>
            <span class="dl-file">{p.file}</span>
          </a>
          {p.alt && <a class="dl-alt" href={releasesPage} data-asset={p.alt.asset}>{p.alt.label}</a>}
        </div>
      ))}
    </div>
    <p class="dl-note mt-caption">The macOS packages are not signed yet, so Gatekeeper warns. All files are on <a href={releasesPage}>GitHub Releases</a>.</p>
  </dialog>

  <section id="ai">
    <div class="ai">
      <img class="ai-head" src="/skeleton.png" alt="The Dancing Skeleton sign from Kenshi" width="180" height="180" loading="lazy" />
      <div class="ai-text">
        <h2>AI Disclaimer</h2>
        <p>
          Agentic coding was used liberally on this codebase. Much of the code, the tests and the documentation was written
          by AI coding agents, directed and reviewed by a human. The result is open source, so judge it by reading it.
        </p>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="about">
      <h2>About</h2>
      <p class="lead">
        MeitouClient is an open-source reimplementation of the Kenshi engine in C# and .NET 11 with a Vulkan renderer. It is a
        drop-in replacement: the original game content, FCS mods and vanilla save games run unchanged. It needs your own copy
        of Kenshi, and no game assets are distributed.
      </p>
      <div class="modes">
        <div class="mode">
          <h3>Faithful</h3>
          <p>The game as it ships: its look, behaviour and formulas, kept close to the original.</p>
        </div>
        <div class="mode mode-meitou">
          <h3>Meitou <span>default</span></h3>
          <p>Our graphical and gameplay enhancements in the theme of vanilla Kenshi.</p>
        </div>
      </div>
      <p class="switches">
        <svg viewBox="0 0 36 20" width="36" height="20" aria-hidden="true"><rect x="1" y="1" width="34" height="18" rx="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="26" cy="10" r="5" fill="currentColor" /></svg>
        Every enhancement is its own switch, so the two modes can be mixed freely.
      </p>
      <div class="divider" role="separator"></div>
      <p class="belief">
        We are of the belief that Kenshi is a phenomenal game held back by its technology. The MeitouClient project seeks to
        enhance the experience while keeping the spirit of the base game intact, while allowing the player the freedom to
        customize the experience to be as close to vanilla as they want.
      </p>
      <div class="divider" role="separator"></div>
      <p class="license">The project is free, fully open-source and licensed under GPL-3.</p>
      <div class="links">
        <a class="mt-btn" href="https://discord.gg/DVAHH2n9DR"><DiscordIcon /><span>Discord</span></a>
        <a class="mt-btn" href="https://github.com/VlcekM/MeitouClient"><GithubIcon /><span>GitHub</span></a>
      </div>
    </div>
  </section>

  <section id="compare">
    <div class="cmp-head">
      <h2>Enhanced Graphics</h2>
      <p>advanced graphics features such as global illumination, long-distance shadows, vastly increased render distances and DLSS possible. All enhancements are fully configurable.</p>
    </div>
    <div class="mt-tabs cmp-tabs" role="tablist">
      {pairs.map((p, i) => <button class="mt-tab" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{p.name}</button>)}
    </div>
    <div class="cmp-stage">
      {pairs.map((p, i) => (
        <div class="cmp" role="tabpanel" hidden={i > 0}>
          <img class="cmp-img" src={p.before} alt="" loading="lazy" />
          <img class="cmp-img cmp-after" src={p.after} alt="" loading="lazy" />
          <span class="cmp-label cmp-left">Before</span>
          <span class="cmp-label cmp-right">After</span>
          <span class="cmp-bar" aria-hidden="true"></span>
          <input class="cmp-range" type="range" min="0" max="100" value="50" aria-label={`${p.name} comparison position`} />
        </div>
      ))}
    </div>
  </section>

  <section id="performance">
    <div class="perf">
      <div class="perf-text">
        <h2>Built for performance</h2>
        <p>Developed on a RTX 4070 and Ryzen 5 3600, the goal was 1080p 144FPS at all times with DLSS. Also runs on integrated GPU office PCs.</p>
      </div>
      <video class="perf-video" controls muted loop playsinline preload="metadata" poster="/fast-loading.jpg">
        <source src={performanceVideo} type="video/webm" />
      </video>
    </div>
  </section>

</Base>

<script>
  // Download: the dialog offers each platform's setup from the newest launcher release. Game releases share the repository and
  // can be its "latest", so the launcher's is looked up by tag; until it is found (or if GitHub can't be reached) the links
  // fall back to the releases page.
  const dialog = document.querySelector<HTMLDialogElement>('.dl')!;
  let assets: Promise<Map<string, string>> | undefined;
  const findAssets = () => assets ??= fetch('https://api.github.com/repos/VlcekM/MeitouClient/releases?per_page=50')
    .then((r) => r.ok ? r.json() : [])
    .then((releases: { tag_name: string; prerelease: boolean; draft: boolean; assets: { name: string; browser_download_url: string }[] }[]) => {
      const launcher = releases.find((r) => r.tag_name.startsWith('launcher-v') && !r.prerelease && !r.draft);
      if (!launcher) return new Map();
      dialog.querySelector('.dl-version')!.textContent = `Version ${launcher.tag_name.slice('launcher-v'.length)}.`;
      return new Map(launcher.assets.map((a) => [a.name, a.browser_download_url]));
    })
    .catch(() => new Map());
  const os = /Win/.test(navigator.userAgent) ? 'windows' : /Mac/.test(navigator.userAgent) ? 'macos' : /Linux|X11/.test(navigator.userAgent) ? 'linux' : '';
  dialog.querySelector(`.dl-choice[data-os="${os}"]`)?.classList.add('is-detected');
  document.querySelector('[data-download]')!.addEventListener('click', (e) => {
    e.preventDefault();
    findAssets();
    dialog.showModal();
  });
  dialog.querySelectorAll<HTMLAnchorElement>('[data-asset]').forEach((a) => a.addEventListener('click', async (e) => {
    e.preventDefault();
    const url = (await findAssets()).get(a.dataset.asset!);
    if (url) { location.href = url; dialog.close(); } else window.open(a.href, '_blank', 'noopener');
  }));
  // A click on the backdrop (outside the plate) closes it.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  const tabs = document.querySelectorAll<HTMLElement>('.cmp-tabs [role=tab]');
  const panels = document.querySelectorAll<HTMLElement>('.cmp');
  tabs.forEach((tab, i) => tab.addEventListener('click', () => {
    tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
    panels.forEach((p, j) => { p.hidden = i !== j; });
  }));
  document.querySelectorAll<HTMLInputElement>('.cmp-range').forEach((r) => r.addEventListener('input', () => {
    r.closest<HTMLElement>('.cmp')!.style.setProperty('--pos', `${r.value}%`);
  }));
</script>

<style>
  /* Fills the first view, stack at the top left in place of the wordmark. */
  .hero { position: relative; display: flex; align-items: flex-start; min-height: 100svh; padding: var(--edge) 0; }
  /* A main menu plate button (320 x 38, icon column 24 at 12, label at 48), bottom left, level with the wordmark. */
  .actions { position: absolute; left: 0; bottom: calc(var(--edge) - 5px); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); max-width: 100%; }
  .more { max-width: 100%; justify-content: flex-start; padding: 0 20px 0 12px; }
  .more-icon { position: relative; flex: none; opacity: .8; transition: opacity .16s ease; }
  .more:hover .more-icon { opacity: 1; }
  /* The trailer: a round brass-rimmed play button centred at the bottom of the first view, its label beneath. */
  .trailer { position: absolute; left: 50%; bottom: calc(var(--edge) - 5px); display: flex; flex-direction: column; align-items: center; gap: var(--space-4); color: var(--paper-light); text-decoration: none; transform: translateX(-50%); }
  .trailer-disc { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: rgba(8, 6, 5, .55); box-shadow: inset 0 0 0 2px var(--brass-light), 0 2px 12px rgba(8, 6, 5, .6); transition: background .16s ease, color .16s ease, transform .16s ease; }
  .trailer-label { font: 600 13px/18px var(--font-exo); letter-spacing: .1em; text-transform: uppercase; text-shadow: 0 1px 8px rgba(8, 6, 5, .8); }
  .trailer:hover .trailer-disc { background: var(--brass); color: var(--secondary); transform: scale(1.06); }
  .trailer:focus-visible { outline: none; }
  .trailer:focus-visible .trailer-disc { outline: 2px solid var(--brass-light); outline-offset: 4px; }
  /* Too narrow to sit between the buttons and the wordmark: stand above the wordmark instead. */
  @media (max-width: 1040px) { .trailer { left: auto; right: 0; bottom: calc(var(--edge) + 56px); transform: none; } }
  /* Download dialog: a plate with three platform cards, the one matching the visitor's system rimmed in brass. */
  .dl { width: min(640px, calc(100vw - 32px)); max-height: calc(100svh - 32px); margin: auto; padding: 28px; border: 0; color: var(--main); }
  .dl::backdrop { background: rgba(8, 6, 5, .7); backdrop-filter: blur(3px); }
  .dl h2 { margin: 0 0 var(--space-4); padding-right: 32px; color: #fff; font: 600 26px/32px var(--font-exo); }
  .dl-sub { margin: 0 0 var(--space-7); font-size: 16px; line-height: 24px; }
  .dl-close { position: absolute; top: 12px; right: 12px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--main); font: 400 28px/1 var(--font-exo); cursor: pointer; }
  .dl-close:hover { color: var(--paper-light); background: rgba(217, 206, 184, .08); }
  .dl-choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .dl-choice { display: flex; flex-direction: column; gap: var(--space-4); }
  .dl-main { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); padding: 24px var(--space-5) 20px; border-radius: calc(2 * var(--radius-card)); background: rgba(8, 6, 5, .45); box-shadow: var(--plate-border); color: var(--paper-light); text-decoration: none; transition: background .16s ease, box-shadow .16s ease; }
  .dl-main:hover { background: rgba(129, 102, 53, .22); box-shadow: inset 0 0 0 1px var(--brass-light); }
  .is-detected .dl-main { box-shadow: inset 0 0 0 1px rgba(196, 160, 98, .55), var(--plate-drop); }
  .dl-name { color: #fff; font: 600 18px/24px var(--font-exo); }
  .dl-file { font: 600 11px/16px var(--font-exo); letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  .dl-alt { align-self: center; color: var(--main); font-size: 13px; line-height: 18px; }
  .dl-alt:hover { color: var(--paper-light); }
  .dl-note { margin: var(--space-7) 0 0; }
  .dl-note a { color: inherit; }
  @media (max-width: 520px) { .dl { padding: 24px var(--space-6); } .dl-choices { grid-template-columns: 1fr; } .dl-main { flex-direction: row; padding: var(--space-5) var(--space-6); } .dl-file { margin-left: auto; } }
  .stack { min-width: 0; }
  h1 { margin: 0 0 var(--space-6); color: #fff; text-shadow: 0 2px 12px rgba(8, 6, 5, .6); white-space: nowrap; font: 600 clamp(32px, 6vw, 52px)/1.1 var(--font-exo); }
  .lede { max-width: 620px; margin: 0; font-size: 18px; line-height: 27px; text-shadow: 0 1px 8px rgba(8, 6, 5, .8); }
  /* The name set like the wordmark: Meitou semibold, Client regular. */
  .name { font-weight: 600; }
  .name > span { font-weight: 400; }
  /* Below the video, where Learn More scrolls: each section a slightly lighter band that runs to the page edges (out of
     main's side padding), its content at most 1280px wide and centred. */
  section:not(.hero) { margin: 0 calc(-1 * var(--edge)); padding: 0 var(--edge); }
  #ai, #compare { background: #151010; }
  #about, #performance { background: #0e0a08; }
  /* Performance: title and text on the left, the video filling the rest, at most 1280px wide and centred. */
  .perf { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 24px; align-items: center; max-width: 1280px; margin: 0 auto; padding: 48px 0; }
  .perf h2 { margin: 0 0 var(--space-5); color: #fff; font: 600 32px/40px var(--font-exo); }
  .perf p { margin: 0; font-size: 18px; line-height: 27px; }
  .perf-video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: calc(2 * var(--radius-card)); background: #000; }
  @media (max-width: 800px) { .perf { grid-template-columns: 1fr; } }
  /* About: as tall as its content, the text centred. */
  /* About: a centred column. The lead and the belief are set larger, the modes are two cards (Meitou lit in brass), the
     dividers carry a brass diamond, and the links are plate buttons. */
  .about { max-width: 960px; margin: 0 auto; padding: 88px 0 96px; text-align: center; }
  .about h2 { margin: 0 0 var(--space-7); color: #fff; font: 600 44px/52px var(--font-exo); }
  .about h2::after { content: ""; display: block; width: 56px; height: 3px; margin: var(--space-6) auto 0; border-radius: 2px; background: var(--brass); }
  .about p { margin: 0 auto; }
  .about .lead { max-width: 780px; color: var(--paper-light); font-size: 21px; line-height: 33px; }
  .modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 48px 0 var(--space-7); text-align: left; }
  .mode { position: relative; padding: var(--space-7) 28px 28px; border-radius: calc(2 * var(--radius-card)); background: rgba(8, 6, 5, .45); box-shadow: var(--plate-border); }
  .mode::before { content: ""; position: absolute; top: 0; left: 28px; width: 40px; height: 3px; border-radius: 0 0 2px 2px; background: var(--greyed-bright); }
  .mode-meitou { box-shadow: inset 0 0 0 1px rgba(196, 160, 98, .55), var(--plate-drop); }
  .mode-meitou::before { background: var(--brass-light); }
  .mode h3 { margin: 0 0 var(--space-4); color: #fff; font: 600 26px/32px var(--font-exo); }
  .mode h3 span { margin-left: var(--space-4); padding: 0 8px; border-radius: var(--radius-portrait); background: var(--brass); color: var(--secondary); font: 600 11px/18px var(--font-exo); letter-spacing: .08em; text-transform: uppercase; vertical-align: middle; }
  .about .mode p { margin: 0; font-size: 17px; line-height: 26px; }
  .about .switches { display: flex; align-items: center; justify-content: center; gap: var(--space-5); font-size: 17px; line-height: 26px; }
  .switches svg { flex: none; color: var(--brass-light); }
  /* A hairline with a brass diamond in the middle. */
  .divider { position: relative; height: 1px; margin: 56px auto; background: linear-gradient(90deg, transparent, rgba(175, 166, 139, .4) 20%, rgba(175, 166, 139, .4) 80%, transparent); }
  .divider::after { content: ""; position: absolute; top: 50%; left: 50%; width: 9px; height: 9px; background: var(--brass-light); box-shadow: 0 0 0 6px #0e0a08; transform: translate(-50%, -50%) rotate(45deg); }
  /* The belief reads as a pull quote. */
  .about .belief { position: relative; max-width: 780px; color: var(--paper-light); font-size: 23px; line-height: 36px; }
  .about .license { display: inline-block; padding: var(--space-4) var(--space-7); border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(196, 160, 98, .5); color: #fff; font-size: 20px; line-height: 30px; }
  .links { display: flex; justify-content: center; gap: var(--space-6); margin-top: 32px; }
  .links .mt-btn { min-width: 160px; }
  @media (max-width: 640px) { .modes { grid-template-columns: 1fr; } .about h2 { font-size: 36px; line-height: 44px; } .about .belief { font-size: 20px; line-height: 32px; } .about .license { border-radius: calc(2 * var(--radius-card)); } }
  .ai { display: flex; align-items: center; justify-content: center; gap: 40px; max-width: 1280px; margin: 0 auto; padding: 48px 0; }
  .cmp-head h2, .ai h2 { margin: 0 0 var(--space-5); color: #fff; font: 600 32px/40px var(--font-exo); }
  .cmp-head p, .ai p { max-width: 620px; margin: 0; font-size: 18px; line-height: 27px; }
  .cmp-head p { max-width: 1000px; }
  /* The disclaimer sits below the first section, a cropped skeleton head beside the text. */
  .ai-head { flex: none; display: block; width: 180px; height: 180px; border-radius: calc(2 * var(--radius-card)); box-shadow: var(--plate-border); }
  /* Compare: title, description and tabs on top, the slider filling what is left of one viewport. It runs as wide as the
     video (frame to frame) and the images are cropped to fit the height. */
  #compare { display: flex; flex-direction: column; height: 100svh; min-height: 480px; padding: 32px var(--frame); }
  .cmp-head { padding: 0 calc(var(--edge) - var(--frame)); margin-bottom: var(--space-6); }
  .cmp-tabs { align-self: flex-start; margin: 0 calc(var(--edge) - var(--frame)) var(--space-6); }
  .cmp-tabs .mt-tab { border: 0; background: none; cursor: pointer; }
  .cmp-tabs .mt-tab[aria-selected="true"] { color: var(--paper-light); background: linear-gradient(#241f1c, #3a3430); box-shadow: inset 0 0 0 1px var(--metal-edge), inset 0 -2px 0 var(--brass); }
  .cmp-stage { position: relative; flex: 1; min-height: 0; overflow: hidden; border-radius: calc(4 * var(--radius-card)); }
  .cmp { position: absolute; inset: 0; --pos: 50%; }
  .cmp-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .cmp-after { clip-path: inset(0 0 0 var(--pos)); }
  .cmp-bar { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--paper-light); box-shadow: 0 0 8px rgba(0, 0, 0, .6); pointer-events: none; }
  .cmp-bar::after { content: "\2039 \203A"; position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: var(--plate); box-shadow: 0 0 0 2px var(--paper-light), var(--plate-drop); color: var(--paper-light); font: 600 22px/1 var(--font-exo); white-space: pre; }
  .cmp-label { position: absolute; top: var(--space-6); padding: 0 10px; border-radius: var(--radius-portrait); background: rgba(8, 6, 5, .6); color: var(--paper-light); font: 600 12px/24px var(--font-exo); letter-spacing: .08em; text-transform: uppercase; pointer-events: none; }
  .cmp-left { left: var(--space-6); }
  .cmp-right { right: var(--space-6); }
  /* The native range sits invisibly over the whole image: it takes the drag and the arrow keys. */
  .cmp-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .cmp:has(.cmp-range:focus-visible) .cmp-bar::after { outline: 2px solid var(--brass-light); outline-offset: 4px; }
  @media (max-width: 640px) { .ai { flex-direction: column; align-items: flex-start; gap: 24px; } }
  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }
  /* Narrow screens: drop the stack below the links at the top right. */
  @media (max-width: 900px) { .hero { padding-top: calc(var(--edge) + 48px); } }
  /* Too narrow for the buttons side by side beside the wordmark: stack them. */
  @media (max-width: 860px) { .actions { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { h1 { white-space: normal; } }

  /* Phones. The frame is gone (see Base.astro), so everything runs on the narrow --edge gutter. */
  @media (max-width: 640px) {
    /* Hero: text on top, the full-width buttons at the bottom, clear of the wordmark below them. */
    .hero { flex-direction: column; justify-content: space-between; gap: var(--space-7); padding-bottom: calc(var(--edge) + 52px); }
