---
// Benchmarks: the launcher's benchmark sessions, inside the site's header and footer. Nothing is read at build time:
// src/scripts/bench.js fetches the sessions from the Reports service (GET /bench/data, /bench/targets) in the browser and draws
// everything, so the page builds without data and shows a message when the service is down or empty.
import '@fontsource/exo-2/700.css';
import Base from '../layouts/Base.astro';

const backgrounds = [1, 2, 3, 4].map((i) => `/backgrounds/bg-${i}.jpg`);
const service = 'https://gear-pastry-chorus.cloudovna.app';
const basesGroups: [string, string, string, [string, string][]][] = [
  [
    'Camera',
    'camera',
    'Basic camera movement around the starting base.',
    [
      ['idle', 'Stationary camera looking at the starting base.'],
      ['orbit', 'Full 360° camera rotation around the base.'],
      ['zoom', 'Zooms out to maximum camera distance and back in.'],
      ['pan', 'Smoothly pans the camera across the terrain at normal speed.'],
    ],
  ],
  [
    'Streaming',
    'streaming',
    'Fast camera movement across the map to stress world and terrain streaming.',
    [
      ['travel', 'High-speed camera travel across the map (3,000 units/s), forcing new terrain, foliage, and zones to stream in.'],
      ['return', 'Snaps the camera back to the starting base.'],
    ],
  ],
  [
    'Simulation',
    'simulation',
    'Higher game speeds, NPC and world interactions, pathfinding bursts, and combat.',
    [
      ['speed-x2', 'Follows the squad leader at 2x game speed.'],
      ['speed-x5', 'Follows the squad leader at 5x game speed.'],
      ['talk', 'Returns to 1x speed and initiates dialogue with the nearest NPC.'],
      ['trade', 'Opens the trade screen with the nearest trader.'],
      ['container', 'Opens the nearest unlocked container.'],
      ['doors', 'Toggles the three nearest doors.'],
      ['pick-up', 'Orders the leader to pick up the nearest ground item.'],
      ['paths', 'Sends the squad or individual members to random destinations 20–200 m away every 0.5 s to stress pathfinding.'],
      ['walk', 'Moves the squad 600 units across the terrain at normal speed.'],
      ['fight', 'Spawns six hostile NPCs beside the squad.'],
      ['fight-on', 'Orders the squad to attack the nearest enemy.'],
      ['loot', 'Orders the leader to loot the nearest downed body.'],
    ],
  ],
  [
    'UI',
    'ui',
    'Opening and switching between in-game interface panels.',
    [
      ['panels', 'Opens inventory, stats, and world overview panels for the first time (cold).'],
      ['panels-warm', 'Re-opens inventory, stats, and overview (warm), plus the limbs and build menus.'],
    ],
  ],
  [
    'Views',
    'views',
    'Heavy draw-distance angles and jumping between squad members.',
    [
      ['horizon', 'Low, grazing 360° sweep showing maximum terrain, foliage, and distant objects.'],
      ['overview', 'Top-down view from the farthest camera distance.'],
      ['flights', 'Hops the camera between the first six player characters twice (6 s each), as if double-clicking their portraits.'],
    ],
  ],
  [
    'All segments',
    'all',
    'Combined results across every measured segment in the scenario (excluding settle).',
    [],
  ],
];

const sharkGroups: [string, string, string, [string, string][]][] = [
  [
    'Flight',
    'flight',
    'Fixed camera flyby around the busy swamp town of Shark.',
    [
      ['circle-high', 'Full 360° high-altitude orbit around Shark.'],
      ['circle-low', 'Full 360° closer, lower-angle orbit around the town.'],
      ['pass', 'Low-altitude fly-through straight across the centre of Shark.'],
    ],
  ],
  [
    'All segments',
    'all',
    'Combined results across the whole flyby (same as flight, excluding settle).',
    [],
  ],
];
---
<Base title="Benchmarks - Meitou" description="Performance benchmarks of Meitou builds on players' machines, taken with the Meitou launcher." kofiTop>
  <span slot="center">Benchmark page by <a href="https://github.com/Demitrix2k">@DemitriX</a></span>
  <div class="backdrop" aria-hidden="true" data-bgs={JSON.stringify(backgrounds)}><div></div><div></div></div>
  <div class="bn" id="bench-root" data-service={service}>
    <header>
      <h1>Meitou benchmarks</h1>
      <p>Meitou releases and daily builds benchmarked on players' machines — always rendered at 1080p (1920×1080). Lower is better, except fps.</p>
    </header>

    <section id="charts-sec">
      <h2>Results</h2>
      <div id="toolbar" class="toolbar" hidden>
        <div id="controls" class="tb-controls"></div>
        <p id="group-desc" class="tb-desc muted small" hidden></p>
      </div>
      <div id="caveat"></div>
      <div id="status" class="box is-loading" role="status" aria-label="Loading benchmark results"><span class="spinner" aria-hidden="true"></span></div>
      <div id="chart"></div>
    </section>

    <section class="minor" id="machines-sec">
      <h2>Machines</h2>
      <div id="machines"></div>
    </section>

    <section class="minor" id="contribute-sec">
      <h2>How to take part</h2>
      <p>Open the <strong>Benchmark</strong> page in the <a href="/">Meitou launcher</a>, pick a build and the tiers, start it and
      submit the results when it is done. It downloads the build and the save on its own; don't use the computer while it runs.</p>
    </section>

    <details class="plain method" id="method">
      <summary>How this is measured</summary>
      <dl class="setup">
        <div><dt>Builds</dt><dd>Every release and each scheduled daily build (17:00 UTC); other builds can be benchmarked but not submitted</dd></div>
        <div><dt>Scenarios</dt><dd><strong>Bases</strong>: a frozen save (<code>bench-bases-2026-10-27</code>, two player bases), checked by hash.
          <strong>Shark flyby</strong>: a new game's default start, the camera flown round the town Shark on a fixed path</dd></div>
        <div><dt>Graphics</dt><dd>A quality tier from default settings, Vulkan, windowed 1920x1080, no frame limit or vsync, no upscaler</dd></div>
        <div><dt>Runs</dt><dd>Two launches per scenario and tier; run 1 may be cache-cold, so the chart shows run 2 and run 1 dimmed, never an average</dd></div>
      </dl>
      <h3>Segments of the Bases scenario</h3>
      <p class="muted">The game's play benchmark script, grouped by what each phase stresses. <code>settle</code> runs first to let the
      world finish loading and initial streaming, and is never counted in any group.</p>
      <table class="groups">
        <tbody>
          {basesGroups.map(([name, id, desc, segs]) => (
            <tr>
              <td><strong>{name}</strong><br /><code>{id}</code></td>
              <td>
                {desc}
                {segs.length > 0 && (
                  <ul class="seg-list">
                    {segs.map(([seg, meaning]) => <li><code>{seg}</code> &mdash; {meaning}</li>)}
                  </ul>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <h3>Segments of the Shark flyby scenario</h3>
      <p class="muted">A new game teleported to the town Shark. <code>settle</code> waits until at least 50 town residents have spawned
      and settled before recording begins (never counted).</p>
      <table class="groups">
        <tbody>
          {sharkGroups.map(([name, id, desc, segs]) => (
            <tr>
              <td><strong>{name}</strong><br /><code>{id}</code></td>
              <td>
                {desc}
                {segs.length > 0 && (
                  <ul class="seg-list">
                    {segs.map(([seg, meaning]) => <li><code>{seg}</code> &mdash; {meaning}</li>)}
                  </ul>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <h3>Version ranges</h3>
      <p>The builds of one version range perform alike, so the chart shows them together: a dot per machine, platform and build,
      spread along the X axis only so they don't overlap (each keeps its place). A new range starts when a build makes the game faster
      or slower, or when the benchmark's workload changes (tiers, settings, segments, save, metric definitions); numbers of different
      ranges are never compared. <strong>Legacy kit</strong> is the earlier Python kit: the play benchmark (idle, orbit, zoom, pan) and
      the base switch, at the old baseline settings and each machine's own resolution, all its commits together.</p>
    </details>

    <p class="muted small">Raw data: <a href={`${service}/bench/data`}>/bench/data</a></p>
    <div id="tip" role="tooltip" hidden></div>
    <noscript><p>This page needs JavaScript to fetch and draw the results.</p></noscript>
  </div>
</Base>

<script>
  import '../scripts/bench.js';
</script>

<script is:inline>
  // Backdrop: a random screenshot at load, then a different one every 20 s, cross-faded (not while the tab is hidden).
  (() => {
    const box = document.querySelector('.backdrop'), bgs = JSON.parse(box.dataset.bgs), layers = box.children;
    let cur = Math.floor(Math.random() * bgs.length), front = 0;
    layers[0].style.backgroundImage = `url(${bgs[cur]})`;
    layers[0].classList.add('on');
    setInterval(() => {
      if (document.hidden) return;
      let next = Math.floor(Math.random() * (bgs.length - 1)); if (next >= cur) next++;
      const img = new Image();
      img.onload = () => {
        const back = layers[1 - front];
        back.style.backgroundImage = `url(${bgs[next]})`;
        back.classList.add('on'); layers[front].classList.remove('on');
        front = 1 - front; cur = next;
      };
      img.src = bgs[next];
    }, 20000);
  })();
</script>

<style is:global>
  /* The body and the site frame are transparent on this page so the backdrop shows behind them (html keeps the ground colour). */
  body:has(.bn), .mt-scene:has(.bn) { background: transparent; }
  .mt-scene:has(.bn) .top { padding-top: 16px; padding-bottom: 32px; }

  .backdrop, .bn {
    --bg: #1c1613; --panel: #2a201b; --text: #eadfcb; --muted: #a8977f; --line: #3d312a; --grid: #33281f; --accent: #e07b45;
    --m0: #6ea0ff; --m1: #f0a53c; --m2: #4ade80; --m3: #c084fc; --m4: #f472b6; --m5: #22d3ee; --m6: #a3e635; --m7: #a8a29e;
    --good: #7fd09c; --bad: #f08b82; --panel-a: 94%;
  }
  .backdrop { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: var(--bg); }
  .backdrop div { position: absolute; inset: -32px; background-size: cover; background-position: center; filter: blur(3px) saturate(.9); opacity: 0; }
  .backdrop div.on { opacity: 1; }
  .backdrop::after { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 92%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .backdrop div { transition: opacity 1.5s ease; } }

  /* Everything the script draws sits under .bn (nested rules), so nothing leaks to other pages. */
  .bn { max-width: 90%; margin: 0 auto; padding: 8px 0 64px; color: var(--text); font: 15px/1.5 var(--font-exo); min-width: 0; }
  .bn h1 { margin: 0 0 .5rem; font-size: 2.3rem; font-weight: 700; line-height: 1.1; letter-spacing: .01em; color: var(--text); }
  .bn > header { text-align: center; text-wrap: balance; }
  .bn > header p { margin: 0; color: var(--text); font-size: 1.05rem; }
  .bn :is(h2, h3) { color: var(--text); }
  .bn {
  h2{font-size:1.45rem;font-weight:600;margin:1.6rem 0 .5rem;letter-spacing:.01em}
  h3{font-size:1.1rem;font-weight:600;margin:0}
  a{color:var(--accent)}
  code{font:.9em ui-monospace,Menlo,Consolas,monospace;background:var(--grid);padding:.05em .3em;border-radius:4px}
  .muted{color:var(--muted)}
  .small{font-size:.9rem;margin:.4rem 0 .2rem}
  .box{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:14px 18px;margin:16px 0}
  #charts-sec:has(.is-loading){min-height:660px}
  #machines:empty{min-height:220px}
  .box.is-loading{display:flex;align-items:center;justify-content:center;min-height:600px;margin:12px 0 0}
  .spinner{width:36px;height:36px;border-radius:50%;border:3px solid color-mix(in srgb,var(--line) 85%,transparent);border-top-color:var(--accent);animation:bn-spin .75s cubic-bezier(.5,.15,.5,.85) infinite}
  & > section > h2{margin-top:2rem}
  .setup{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px 24px;margin:.6rem 0}
  .setup dt{font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
  .setup dd{margin:0}
  summary{cursor:pointer;font-weight:600}
  select{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:3px 8px}
  .mbar{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin:0 0 8px}
  .msearch{display:block;width:min(320px,100%);margin:0;padding:5px 10px;border-radius:999px;border:1px solid var(--line);background:color-mix(in srgb,var(--bg) 65%,transparent);color:var(--text);font:inherit;font-size:.88rem;flex:0 1 auto}
  .msearch::placeholder{color:var(--muted)}
  .mcount{font-size:.84rem}
  .mclear,.pager button{font:inherit;font-size:.84rem;color:var(--text);background:color-mix(in srgb,var(--bg) 55%,transparent);border:1px solid var(--line);border-radius:999px;padding:3px 12px;cursor:pointer}
  .mclear[hidden]{display:none}
  .pager{display:flex;align-items:center;justify-content:center;gap:12px;margin:8px 0 0;font-size:.86rem}
  .pager button:disabled{opacity:.4;cursor:default}
  .chart-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 16px;padding:2px 6px 6px}
  .legend{display:flex;gap:6px 14px;flex-wrap:wrap;font-size:.82rem;color:var(--muted);margin:0}
  .legend svg{vertical-align:-3px}
  .chart{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:12px 12px 6px;min-width:0}
  .chart h3{font-size:.98rem;padding:0}
  .chart svg{display:block;overflow:visible;max-width:100%;height:auto}
  .chart text{fill:var(--muted);font-size:12.5px;font-family:inherit}
  .chart .grid{stroke:var(--grid);stroke-width:1}
  .chart .hit{fill:transparent;cursor:pointer}
  .chart .ml{fill:none;stroke-width:1.6}
  .chart .p1{stroke:var(--panel);stroke-width:1.5;opacity:.35}
  .chart .p1.only{opacity:1}
  .chart .p2{fill:var(--panel);stroke-width:2}
  .chart .hit:focus-visible{outline:none;fill:color-mix(in srgb,var(--accent) 25%,transparent);stroke:var(--accent);stroke-width:2.5}
  table{border-collapse:collapse;width:100%;font-size:.92rem}
  th,td{padding:5px 8px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
  th:first-child,td:first-child{text-align:left;white-space:normal}
  th{color:var(--muted);font-weight:600;font-size:.8rem}
  td.l,th.l{text-align:left}
  .tablewrap{overflow-x:auto;overflow-y:hidden}
  .mtable{font-size:.86rem}
  .mtable :is(th,td){padding:2px 6px;line-height:1.35}
  .mtable th.ck,.mtable td.ck{width:1.6rem;padding-right:0;text-align:center}
  .mtable td.ck input{margin:0;vertical-align:middle;accent-color:var(--accent);cursor:pointer}
  .mtable tbody tr{cursor:pointer}
  .mtable tbody tr.is-checked>*{background:color-mix(in srgb,var(--accent) 14%,transparent)}
  .mtable td:nth-child(2){text-align:left;white-space:normal;min-width:12rem}
  .mtable td.l{white-space:normal}
  .msub{display:none}
  @media (max-width:700px){
    .mtable .wide{display:none}
    .mtable td:nth-child(2){min-width:0}
    .msub{display:block;color:var(--muted);font-size:.8rem}
  }
  .sort-btn{display:inline-flex;align-items:center;gap:4px;font:inherit;color:inherit;background:none;border:0;padding:2px 0;cursor:pointer;white-space:nowrap}
  .sort-btn:hover,.sort-btn.is-active{color:var(--text)}
  .sort-ind{display:inline-block;width:1em;text-align:center;font-size:.7rem;opacity:.32}
  .sort-btn:hover .sort-ind{opacity:.75}
  .sort-btn.is-active .sort-ind{opacity:1;color:var(--accent)}
  .groups td{text-align:left;white-space:normal;vertical-align:top}
  .groups td:first-child{width:9rem;color:var(--muted)}
  .groups td:first-child strong{color:var(--text)}
  .seg-list{margin:.35rem 0 0;padding-left:1.15rem;color:var(--muted);font-size:.88rem}
  .seg-list li{margin:.15rem 0}
  .seg-list code{color:var(--text)}
  #tip{position:fixed;z-index:10;pointer-events:none;background:var(--panel)!important;color:var(--text);border:1px solid var(--line);
    border-radius:8px;padding:6px 10px;font-size:.85rem;box-shadow:0 4px 14px rgba(0,0,0,.2);max-width:300px}
  .dot{display:inline-block;width:.7em;height:.7em;border-radius:50%;margin-right:.35em;vertical-align:baseline}
  .toolbar{background:color-mix(in srgb,var(--panel) var(--panel-a),transparent);backdrop-filter:blur(2px);border:1px solid var(--line);border-radius:16px;padding:12px 16px;margin:12px 0 14px;display:flex;flex-direction:column;gap:10px}
  .tb-controls{display:flex;flex-direction:column;gap:8px}
  .tb-row{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center}
  .tb-metric{margin-left:auto}
  .tb-desc{margin:0;font-size:.85rem}
  .ctl{display:inline-flex;align-items:center;gap:8px;font-size:.86rem;color:var(--muted)}
  .caveat{border:1px solid var(--bad);border-radius:20px;padding:8px 14px;background:var(--panel);margin:8px 0}
  .seg{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:color-mix(in srgb,var(--bg) 55%,transparent)}
  .seg button{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:.86rem;color:var(--muted);background:transparent;border:0;padding:4px 12px;cursor:pointer}
  .seg button[aria-pressed="true"]{background:var(--accent);color:var(--bg);font-weight:600}
  .seg .seg-n{display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;font-size:.72rem;font-weight:600;line-height:1;font-variant-numeric:tabular-nums;background:color-mix(in srgb,var(--line) 85%,transparent);color:var(--text)}
  .seg button[aria-pressed="true"] .seg-n{background:rgba(28,22,19,.24);color:var(--bg)}
  .seg .seg-n.is-zero{opacity:.42}
  .seg button{white-space:nowrap}
  @media (max-width:700px){
    .tb-metric{margin-left:0}
    .ctl{flex-wrap:wrap;max-width:100%}
    .ctl select{max-width:100%}
    .seg{flex-wrap:wrap;border-radius:14px;max-width:100%}
  }
  .method h3{margin:1.2rem 0 .3rem}
  .method > summary{font-size:1.05rem;padding:2px 0}
  .plain{margin:18px 0;padding:8px 0 0;border-top:1px solid var(--line)}
  .plain > summary{font-size:1.05rem;font-weight:600;color:var(--muted)}
  .minor{margin:18px 0}
  .minor h2{font-size:1.05rem;color:var(--muted);margin:.4rem 0 .4rem}
  @media (max-width:700px){.box{padding:12px 14px}}

  /* Panels are semi-opaque while a backdrop shows. */
  .box,.chart,.caveat,select{background:color-mix(in srgb,var(--panel) var(--panel-a),transparent)}
  .box{backdrop-filter:blur(2px)}
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  tbody tr:focus-within{background:color-mix(in srgb,var(--accent) 12%,transparent)}
  @media (hover:hover){
    tbody tr:hover>*{background:color-mix(in srgb,var(--accent) 20%,transparent)}
    summary:hover{background:color-mix(in srgb,var(--accent) 12%,transparent);border-radius:8px}
    .seg button[aria-pressed="false"]:hover{background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--text)}
    .mclear:hover,.pager button:not(:disabled):hover{border-color:var(--accent)}
    .chart .hit:hover{fill:color-mix(in srgb,var(--accent) 25%,transparent);stroke:var(--accent);stroke-width:2.5}
  }
  @media (prefers-reduced-motion:no-preference){
    tbody tr>*,summary,.seg button,.seg .seg-n{transition:background-color .14s cubic-bezier(.22,1,.36,1),border-color .14s ease,color .14s ease,opacity .14s ease,transform .14s cubic-bezier(.22,1,.36,1)}
    .seg button:active{transform:scale(.97)}
    .chart,.caveat{animation:bn-pop .24s cubic-bezier(.22,1,.36,1) both}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  }
  @keyframes bn-pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes bn-spin{to{transform:rotate(360deg)}}
  @media (max-width: 700px) { .bn h1 { font-size: 1.8rem; } }
</style>
