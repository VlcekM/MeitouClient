---
// Roadmap: what each Meitou version brings, from src/data/roadmap.ts, inside the site's header and footer, in the site's Exo 2 and
// rounded plates: status tiles that filter the features (kept in the query string so a filtered view is linkable), a search, one
// link per version with a status bar and its areas under it, one table per area, and Kenshi screenshots behind it that change every
// 20 s. On wide screens the filters and versions stay in a sticky column beside the tables.
import '@fontsource/exo-2/700.css';
import Base from '../layouts/Base.astro';
import { allFeatures, countBy, featuresOf, order, statuses, versionId, versions } from '../data/roadmap';
import type { Area, Feature, Version } from '../data/roadmap';

const counts = countBy(allFeatures);
const backgrounds = [1, 2, 3, 4].map((i) => `/roadmap-bg/bg-${i}.jpg`);
// A status bar: each status's share of the features.
const bar = (features: Feature[]) => order.map((k) => ({ k, width: features.length ? (100 * countBy(features)[k]) / features.length : 0 }));
const label = (v: Version) => (v.name ? `${v.version} · ${v.name}` : v.version);
// The areas a version's tables are drawn as: its own features first, as an area without a heading.
const areasOf = (v: Version): Area[] => [...(v.features?.length ? [{ id: 'features', name: '', features: v.features }] : []), ...(v.areas ?? [])];
// A note's text and its [text](url) links, in order.
const noteParts = (note: string) => note.split(/\[([^\]]+)\]\((https?:[^)\s]+)\)/).reduce<{ text: string; href?: string }[]>((parts, s, i) => {
  if (i % 3 === 0) parts.push({ text: s });
  else if (i % 3 === 1) parts.push({ text: s, href: '' });
  else parts[parts.length - 1].href = s;
  return parts;
}, []);
const summary = (features: Feature[]) => {
  const c = countBy(features);
  return order.filter((k) => c[k]).map((k) => `${c[k]} ${statuses[k].label.toLowerCase()}`).join(' · ');
};
---
<Base title="Roadmap - Meitou" description="What each Meitou version brings, and how far it is." kofiTop>
  <span slot="center">Roadmap page by <a href="https://github.com/Demitrix2k">@DemitriX</a></span>
  <div class="backdrop" aria-hidden="true" data-bgs={JSON.stringify(backgrounds)}><div></div><div></div></div>
  <div class="rd">
    <header>
      <h1>What each Meitou version brings</h1>
      <p>
        The features planned for each version, by area. <b>Done</b> is in Meitou, <b>In progress</b> is in Meitou with known gaps,
        and <b>Planned</b> is not started. Bugs and their fixes are tracked as{' '}
        <a href="https://github.com/VlcekM/MeitouClient/issues">GitHub issues</a>.
      </p>
    </header>

    <aside class="side">
    <section aria-labelledby="status-h">
      <h2 id="status-h">Status at a glance</h2>
      <input type="search" class="search" placeholder="Search features and notes" aria-label="Search features and notes" hidden />
      <div class="tiles" role="group" aria-label="Filter by status">
        {order.map((k) => (
          <button type="button" class={`tile st-${k}`} data-s={k} title={statuses[k].desc} aria-pressed="false">
            <span class="n">{counts[k]}</span><span class="k">{statuses[k].label}</span><span class="d">{statuses[k].desc}</span>
          </button>
        ))}
      </div>
      <div class="filter-note" hidden>Showing all features. <button type="button" class="clear">Show all</button></div>
    </section>

    <section aria-labelledby="versions-h">
      <h2 id="versions-h">Versions</h2>
      <nav class="loop" aria-label="Versions">
        {versions.map((v) => (
          <>
            <a class="ver" href={`#${versionId(v)}`}>
              <span class="nm">{label(v)}</span>
              <span class="mini">{bar(featuresOf(v)).map((b) => <span class={`st-${b.k}`} style={`width: ${b.width}%`}></span>)}</span>
            </a>
            {(v.areas ?? []).map((a) => (
              <a href={`#${versionId(v)}-${a.id}`}>
                <span class="nm">{a.name}</span>
                <span class="mini">{bar(a.features).map((b) => <span class={`st-${b.k}`} style={`width: ${b.width}%`}></span>)}</span>
              </a>
            ))}
          </>
        ))}
      </nav>
    </section>
    </aside>

    <div class="body">
    {versions.length === 0 && <p class="empty-cats none">Nothing on the roadmap yet.</p>}
    {versions.map((v) => (
      <section class="version" id={versionId(v)}>
        <div class="stage-head">
          {v.name && <span class="eyebrow">Version {v.version}</span>}
          <h2>{v.name ?? `Version ${v.version}`}</h2>
          <span class="meta">{summary(featuresOf(v))}</span>
          {v.blurb && <p>{v.blurb}</p>}
        </div>
        {areasOf(v).map((a) => (
          <section class="stage" id={`${versionId(v)}-${a.id}`} data-name={a.name || label(v)}>
            {a.name && (
              <div class="stage-head">
                <h3>{a.name}</h3>
                <span class="meta">{summary(a.features)}</span>
                {a.blurb && <p>{a.blurb}</p>}
              </div>
            )}
            <div class="tbl">
              <table>
                <thead><tr><th>Feature</th><th>Status</th><th>Notes</th></tr></thead>
                <tbody>
                  {a.features.map((f) => (
                    <tr id={f.id} data-s={f.status}>
                      <td class="sys">{f.name}</td>
                      <td class="st"><span class={`pill st-${f.status}`}>{statuses[f.status].label}</span></td>
                      <td class="note">{noteParts(f.note).map((p) => (p.href ? <a href={p.href}>{p.text}</a> : p.text))}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </section>
    ))}

    <p class="empty-cats" hidden></p>
    </div>
  </div>
  <a class="totop" href="#top" aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 14l6-6 6 6" /></svg>
    <span>Top</span>
  </a>
</Base>

<script is:inline>
  // Backdrop: a random screenshot at load, then a different one every 20 s, cross-faded (not while the tab is hidden).
  (() => {
    const box = document.querySelector('.backdrop'), bgs = JSON.parse(box.dataset.bgs), layers = box.children;
    let cur = Math.floor(Math.random() * bgs.length), front = 0;
    layers[0].style.backgroundImage = `url(${bgs[cur]})`;
    layers[0].classList.add('on');
    setInterval(() => {
      if (document.hidden) return;
      let next = Math.floor(Math.random() * (bgs.length - 1)); if (next >= cur) next++;
      const img = new Image();
      img.onload = () => {
        const back = layers[1 - front];
        back.style.backgroundImage = `url(${bgs[next]})`;
        back.classList.add('on'); layers[front].classList.remove('on');
        front = 1 - front; cur = next;
      };
      img.src = bgs[next];
    }, 20000);
  })();

  // Sticky column: when taller than the window, stick by its bottom edge (a negative top), so it scrolls with the page
  // instead of inside itself.
  (() => {
    const side = document.querySelector('.side');
    const fit = () => side.style.setProperty('--side-top', `${Math.min(16, innerHeight - side.offsetHeight - 16)}px`);
    new ResizeObserver(fit).observe(side);
    addEventListener('resize', fit);
    fit();
  })();

  // Back to top: shown once the page is scrolled past the first screen; smooth unless reduced motion is asked for.
  (() => {
    const btn = document.querySelector('.totop');
    const toggle = () => { btn.hidden = scrollY < innerHeight; };
    addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', location.pathname + location.search);
    });
  })();

  // Filters: one status at a time (click again to clear) and a search over the feature names and notes. Areas and versions with
  // nothing to show are hidden.
  (() => {
    const ORDER = ['done', 'wip', 'planned'];
    const LABEL = { done: 'Done', wip: 'In progress', planned: 'Planned' };
    let active = null, query = '';
    const search = document.querySelector('.search');
    search.hidden = false;
    const rows = [...document.querySelectorAll('tr[data-s]')].map((tr) => ({ tr, s: tr.dataset.s, text: tr.textContent.toLowerCase() }));
    const note = document.querySelector('.filter-note'), clear = note.querySelector('.clear');
    const shows = (r) => (!active || r.s === active) && (!query || r.text.includes(query));
    function showAreas() {
      const left = [];
      document.querySelectorAll('.stage[id]').forEach((sec) => {
        let any = false;
        rows.filter((r) => sec.contains(r.tr)).forEach((r) => { r.tr.hidden = !shows(r); any ||= shows(r); });
        sec.hidden = !any;
        if (!any) left.push(sec.dataset.name);
      });
      document.querySelectorAll('.version').forEach((v) => { v.hidden = !v.querySelector('.stage:not([hidden])'); });

      // Areas with nothing to show are left out, and named in one line after the rest.
      const empty = document.querySelector('.empty-cats:not(.none)');
      empty.textContent = left.length === document.querySelectorAll('.stage[id]').length
        ? 'No features match the filters.' : `No features match the filters in: ${left.join(', ')}.`;
      empty.hidden = !left.length;
    }
    function apply() {
      document.querySelectorAll('.tile').forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.s === active)));
      document.querySelector('.tiles').classList.toggle('filtering', !!active);
      showAreas();
      const parts = [];
      if (active) parts.push(`${LABEL[active]} only`);
      if (query) parts.push(`features matching “${search.value.trim()}”`);
      note.firstChild.textContent = `Showing ${parts.join(', ')}. `;
      note.hidden = !parts.length;

      // The filters live in the query string (defaults left out), so a filtered view can be linked; the #feature anchor stays.
      const qs = new URLSearchParams();
      if (active) qs.set('status', active);
      if (search.value.trim()) qs.set('q', search.value.trim());
      const url = location.pathname + (qs.size ? `?${qs}` : '') + location.hash;
      if (url !== location.pathname + location.search + location.hash) history.replaceState(null, '', url);
    }
    const given = new URLSearchParams(location.search);
    if (ORDER.includes(given.get('status'))) active = given.get('status');
    search.value = given.get('q') ?? '';
    query = search.value.trim().toLowerCase();
    document.querySelector('.tiles').addEventListener('click', (e) => { const t = e.target.closest('.tile'); if (!t) return; active = active === t.dataset.s ? null : t.dataset.s; apply(); });
    search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); });
    clear.addEventListener('click', () => { active = null; query = search.value = ''; apply(); });
    apply();
  })();
</script>

<style is:global>
  /* The body and the site frame are transparent on this page so the backdrop shows behind them (html keeps the ground colour). */
  body:has(.rd), .mt-scene:has(.rd) { background: transparent; }
  /* Less room under the site header here: the roadmap starts right below it. */
  .mt-scene:has(.rd) .top { padding-top: 16px; padding-bottom: 32px; }
</style>

<style>
  .backdrop, .rd {
    --bg: #1c1613; --surface: #2a201b; --fg: #eadfcb; --muted: #a8977f; --line: #3d312a; --accent: #e07b45;
    --done: #7fd09c; --done-bg: #1f3a2a; --wip: #e6b84e; --wip-bg: #3d321a; --planned: #a7b1ac; --planned-bg: #2a312d;
    --font-display: var(--font-exo); --font-body: var(--font-exo); --r-plate: calc(2 * var(--radius-card));
  }
  .backdrop { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: var(--bg); }
  .backdrop div { position: absolute; inset: -32px; background-size: cover; background-position: center; filter: blur(3px) saturate(.9); opacity: 0; }
  .backdrop div.on { opacity: 1; }
  .backdrop::after { content: ""; position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 84%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .backdrop div { transition: opacity 1.5s ease; } }

  .rd, .side, .body { display: grid; gap: 40px; min-width: 0; align-content: start; }
  .rd { max-width: 1080px; margin: 0 auto; padding: 8px 0 64px; color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.5; }
  .rd section { display: grid; gap: 12px; min-width: 0; }
  .rd :is(h1, h2, h3) { font-family: var(--font-display); text-wrap: balance; margin: 0; letter-spacing: .01em; color: var(--fg); }
  .rd h1 { font-size: 2.3rem; font-weight: 700; line-height: 1.1; }
  .rd h2 { font-size: 1.45rem; font-weight: 600; }
  .rd h3 { font-size: 1.1rem; font-weight: 600; }
  .rd p { margin: 0; max-width: 70ch; }
  .rd a { color: var(--accent); }
  .eyebrow { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-size: .85rem; color: var(--muted); font-weight: 600; }
  .meta { color: var(--muted); font-size: .9rem; }
  header { display: grid; gap: 10px; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
  .tile { font: inherit; color: inherit; text-align: left; cursor: pointer; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-plate); padding: 12px 14px 12px 16px; display: grid; gap: 2px; position: relative; overflow: hidden; }
  .tile::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--c); }
  .tile .n { font-family: var(--font-display); font-size: 1.8rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; color: var(--c); }
  .tile .k { font-family: var(--font-display); font-weight: 600; font-size: 1rem; }
  .tile .d { color: var(--muted); font-size: .85rem; }
  .tile:hover, .tile:focus-visible { border-color: var(--c); outline: none; }
  .tile[aria-pressed="true"] { border-color: var(--c); box-shadow: inset 0 0 0 1px var(--c); }
  .tiles.filtering .tile[aria-pressed="false"] { opacity: .55; }

  .loop { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .rd .loop a { text-decoration: none; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 6px 10px; display: grid; gap: 4px; min-width: 118px; }
  .rd .loop a.ver { border-color: var(--accent); }
  .rd .loop a:hover, .rd .loop a:focus-visible { border-color: var(--accent); outline: none; }
  .loop .nm { font-family: var(--font-display); font-weight: 600; font-size: .95rem; }
  .loop .mini { display: flex; height: 5px; border-radius: 3px; overflow: hidden; background: var(--planned-bg); }
  .mini span { display: block; height: 100%; background: var(--c); }

  .pill { display: inline-block; font-size: .78rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; white-space: nowrap; letter-spacing: .02em; color: var(--c); background: var(--cb); }
  .st-done { --c: var(--done); --cb: var(--done-bg); }
  .st-wip { --c: var(--wip); --cb: var(--wip-bg); }
  .st-planned { --c: var(--planned); --cb: var(--planned-bg); }

  .stage, .version { scroll-margin-top: 16px; }
  .version { display: grid; gap: 24px; }
  .rd .empty-cats { max-width: none; margin: 0; padding: 10px 14px; color: var(--muted); font-size: .9rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-plate); }
  .stage-head { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }
  .stage-head p { color: var(--muted); flex-basis: 100%; }
  .tbl { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-plate); }
  table { border-collapse: collapse; width: 100%; min-width: 680px; }
  th, td { text-align: left; vertical-align: top; padding: 9px 12px; border-bottom: 1px solid var(--line); }
  tbody tr:last-child td { border-bottom: 0; }
  th { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; color: var(--muted); }
  td.sys { font-weight: 600; width: 30%; }
  td.st { width: 1%; white-space: nowrap; }
  td.note { color: var(--muted); font-size: .92rem; }
  /* A feature linked as /roadmap#<feature id> is marked. */
  tr[id] { scroll-margin-top: 24px; }
  tr:target td { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  tr:target td.sys { box-shadow: inset 3px 0 0 var(--accent); }
  tr[hidden], table[hidden], [hidden] { display: none !important; }

  /* Back to top: bottom right. */
  .totop {
    position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: max(16px, env(safe-area-inset-bottom, 0px)); z-index: 5;
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--fg);
    font: 600 1rem/1 var(--font-display); letter-spacing: .06em; text-transform: uppercase; text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .45);
    --bg: #1c1613; --surface: #2a201b; --fg: #eadfcb; --line: #3d312a; --accent: #e07b45; --font-display: var(--font-exo);
  }
  .totop:hover, .totop:focus-visible { border-color: var(--accent); color: var(--accent); outline: none; }
  @media (prefers-reduced-motion: no-preference) { .totop { transition: border-color .15s, color .15s; } }

  .search { font: inherit; font-size: .9rem; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; width: 100%; }
  .search:focus-visible { border-color: var(--accent); outline: none; }

  /* Wide screens (16:9 desktops): the filters and versions in a sticky column on the left from the top of the page, the
     header and tables beside it. A column taller than the window scrolls with the page until its bottom shows, then sticks
     (the script sets --side-top). */
  @media (min-width: 1240px) {
    .rd { max-width: none; grid-template-columns: 320px minmax(0, 1fr); grid-template-rows: auto 1fr; gap: 28px 40px; padding-top: 0; }
    .rd > header { grid-column: 2; grid-row: 1; gap: 6px; }
    .rd > header p { max-width: 110ch; grid-column: 1 / -1; }
    .rd h1 { font-size: 2rem; }
    .body { grid-column: 2; grid-row: 2; }
    .side {
      grid-column: 1; grid-row: 1 / span 2; align-self: start; position: sticky; top: var(--side-top, 16px); gap: 22px;
      padding: 16px; border-radius: var(--r-plate); background: color-mix(in srgb, var(--bg) 72%, transparent); border: 1px solid var(--line);
    }
    .side section { gap: 10px; }
    .side .tiles { grid-template-columns: 1fr; gap: 4px; }
    .side .tile { grid-template-columns: 3ch 1fr; column-gap: 10px; align-items: baseline; padding: 5px 12px 5px 16px; border-radius: var(--radius-card); }
    .side .tile .n { font-size: 1.3rem; }
    .side .tile .d { display: none; }
    .side .loop { display: grid; gap: 4px; }
    .rd .side .loop a { grid-template-columns: 1fr 72px; align-items: center; gap: 12px; min-width: 0; padding: 4px 12px; }
    .side .loop .nm { font-size: .9rem; }
  }
  @media (max-width: 560px) { .rd h1 { font-size: 2rem; } }
  @media (prefers-reduced-motion: no-preference) { .tile, .rd .loop a { transition: border-color .15s, opacity .15s; } }
</style>
