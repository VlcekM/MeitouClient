---
// Roadmap: the parity roadmap inside the site's header and footer, in the site's Exo 2 and rounded plates: status tiles and
// platform chips that filter the rows (kept in the query string so a filtered view is linkable), category chips with a
// status bar each, one table per category, and Kenshi screenshots behind it that change every 20 s. On wide screens
// the filters and categories stay in a sticky column beside the tables.
import '@fontsource/exo-2/700.css';
import Base from '../layouts/Base.astro';
import { asOf, allRows, bugs, categories, countBy, fixedSeen, fixedUnseen, order, platformStatus, refUrl, statuses } from '../data/roadmap';
import type { Os, Row } from '../data/roadmap';
import { history } from '../data/history';
import { recheckBefore, reportBuilds } from '../data/releases';
import { reports } from '../data/reports';

const oses: Os[] = ['win', 'linux', 'mac'];
const osShort = { win: 'Win', linux: 'Linux', mac: 'macOS' } as const;
const mark = { works: '✓', untested: '?', wip: '~', bug: '!', missing: '✗', na: '–' } as const;
const platforms = { all: 'All platforms', win: 'Windows', linux: 'Linux', mac: 'macOS', specific: 'Differs by platform' } as const;
const differs = (r: Row) => !!r.platforms && oses.some((os) => platformStatus(r, os) !== platformStatus(r, 'win'));
// Per-row data for the filter script: the status on each platform, whether it differs, whether it has bugs.
const rowData = (r: Row) => JSON.stringify({ s: r.status, p: Object.fromEntries(oses.map((os) => [os, platformStatus(r, os)])), d: differs(r), b: r.bugs.length > 0 });
const counts = countBy(allRows);
const backgrounds = [1, 2, 3, 4].map((i) => `/roadmap-bg/bg-${i}.jpg`);
const stale = (r: Row) => !!r.seen && !!recheckBefore && r.seen.date < recheckBefore;
const byText = (by: string) => (/^#\d+$/.test(by) ? by : by === 'playtest' ? 'a playtest' : by);
// History chart: one stacked bar per day the roadmap changed (newest 40), as percentages of the rows that day.
const snaps = history.snapshots.slice(-40);
const chartW = 640, chartH = 120, barGap = 2;
const barW = snaps.length ? Math.min(28, (chartW - barGap * (snaps.length - 1)) / snaps.length) : 0;
const statusLabel = (s: keyof typeof statuses | null) => (s ? statuses[s].label : 'removed');
const reportConfig = JSON.stringify({ url: reports.url.replace(/\/$/, ''), siteKey: reports.turnstileSiteKey, builds: reportBuilds });
---
<Base title="Roadmap - Meitou" description="How far each of Kenshi's systems is in Meitou, against unmodded Kenshi 1.0.68." kofiTop>
  <span slot="center">Roadmap page by <a href="https://github.com/Demitrix2k">@DemitriX</a></span>
  <div class="backdrop" aria-hidden="true" data-bgs={JSON.stringify(backgrounds)}><div></div><div></div></div>
  <div class="rd">
    <header>
      <h1>What works in Meitou, and what does not yet</h1>
      <p>
        Kenshi's systems, by category. Every system has one status. <b>Works</b> covers what someone has seen working in
        play and reported bugs whose fix is on master; a feature that is only in the code and was never reported is{' '}
        <b>Untested</b>, however complete it looks.
      </p>
      <div class="meta">As of {asOf.date} · <span class="mono">master {asOf.master}</span> · Reference: unmodded Kenshi 1.0.68</div>
    </header>

    <aside class="side">
    <section aria-labelledby="status-h">
      <div class="status-head">
        <h2 id="status-h">Status at a glance</h2>
        <button type="button" class="filt" aria-expanded="false" aria-controls="filters" hidden>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M3 5h18l-7 8.5V19l-4 2v-7.5z" /></svg>
          Filter<span class="fc" hidden></span>
        </button>
      </div>
      <div class="filters" id="filters"><div class="filters-in">
      <div class="plats" role="group" aria-label="Filter by platform">
        <span class="lbl">Platform</span>
        {Object.entries(platforms).map(([k, v]) => <button type="button" class="chip" data-p={k} aria-pressed={String(k === 'all')}>{v}</button>)}
        <span class="lbl gap">Bugs</span>
        <button type="button" class="chip hbchip" data-bugs aria-pressed="false">Has bugs</button>
      </div>
      <input type="search" class="search" placeholder="Search systems and notes" aria-label="Search systems and notes" hidden />
      </div></div>
      <div class="tiles" role="group" aria-label="Filter by status">
        {order.map((k) => (
          <button type="button" class={`tile st-${k}`} data-s={k} title={statuses[k].desc} aria-pressed="false">
            <span class="n">{counts[k]}</span><span class="k">{statuses[k].label}</span><span class="d">{statuses[k].desc}</span>
          </button>
        ))}
      </div>
      <div class="filter-note" hidden>Showing all rows. <button type="button" class="clear">Show all</button></div>
    </section>

    <section aria-labelledby="cats-h">
      <h2 id="cats-h">Categories</h2>
      <nav class="loop" aria-label="Categories">
        {categories.map((c, i) => {
          const cc = countBy(c.rows);
          return (
            <>
              {i > 0 && <span class="arrow" aria-hidden="true">›</span>}
              <a href={`#${c.id}`}>
                <span class="nm">{i + 1}. {c.name}</span>
                <span class="mini" data-bar={c.id}>{order.map((k) => <span class={`st-${k}`} style={`width: ${(100 * cc[k]) / c.rows.length}%`}></span>)}</span>
              </a>
            </>
          );
        })}
      </nav>
    </section>
    </aside>

    <div class="body">
    {categories.map((c, i) => (
      <section class="stage" id={c.id}>
        <div class="stage-head">
          <span class="eyebrow">Category {i + 1}</span>
          <h2>{c.name}</h2>
          <span class="meta" data-sum={c.id}></span>
          <p>{c.blurb}</p>
        </div>
        <div class="tbl">
          <table>
            <thead><tr><th>System</th><th>Status</th><th>What is known</th></tr></thead>
            <tbody>
              {c.rows.map((r) => (
                <tr id={r.id} data-row={rowData(r)}>
                  <td class="sys">
                    {r.system}
                    {r.bugs.length > 0 && <a class="hb" href="#bugs" title={`Known bugs: ${r.bugs.join(', ')}`}>has bugs · {r.bugs.join(', ')}</a>}
                    {differs(r) && (
                      <span class="obs">
                        {oses.map((os) => {
                          const s = platformStatus(r, os);
                          return <span class={`ob st-${s}`} title={`${osShort[os]}: ${s === 'na' ? 'not applicable' : statuses[s].label}`}>{osShort[os]} {mark[s]}</span>;
                        })}
                      </span>
                    )}
                  </td>
                  <td class="st"><span class={`pill st-${r.status}`}>{statuses[r.status].label}</span></td>
                  <td class="note">
                    {r.note}
                    {r.seen && (
                      <span class:list={['seen', { stale: stale(r) }]}>
                        {stale(r) ? `Not rechecked since ${r.seen.build} (${r.seen.date})` : `Last confirmed on ${r.seen.build}, ${r.seen.date}, by ${byText(r.seen.by)}`}
                      </span>
                    )}
                    <span class="rep" data-rep={r.id} data-name={r.system} hidden>
                      <span class="rc"></span>
                      <button type="button" data-v="works">Works for me</button>
                      <button type="button" data-v="broken">Broken</button>
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <p class="empty-cats" hidden></p>

    <section id="bugs" class="stage" aria-labelledby="bugs-h">
      <h2 id="bugs-h">Known bugs</h2>
      <p class="meta">Open differences and faults seen in play, as issues on GitHub.</p>
      <div class="tbl">
        <table>
          <thead><tr><th>ID</th><th>What is seen</th><th>What the original does</th><th>State</th><th>Platform</th></tr></thead>
          <tbody>
            {bugs.map((b) => (
              <tr>
                <td class="ref">{refUrl(b.id) ? <a href={refUrl(b.id)}>{b.id}</a> : b.id}</td>
                <td>{b.seen}</td>
                <td class="note">{b.original}</td>
                <td class="note">{b.state}</td>
                <td class="note">{b.platform ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="fixed-h">
      <h2 id="fixed-h">Recently fixed</h2>
      <div class="cols">
        <div>
          <h3>Fixed on master</h3>
          <p class="meta">Not yet seen in play.</p>
          <ul class="fixlist">{fixedUnseen.map((f) => <li><span class="tag">{refUrl(f.id) ? <a href={refUrl(f.id)}>{f.id}</a> : f.id || '—'}</span><span>{f.text}</span></li>)}</ul>
        </div>
        <div>
          <h3>Fixed and seen in play</h3>
          <p class="meta">Merged and checked in the game.</p>
          <ul class="fixlist">{fixedSeen.map((f) => <li><span class="tag">{refUrl(f.id) ? <a href={refUrl(f.id)}>{f.id}</a> : f.id || '—'}</span><span>{f.text}</span></li>)}</ul>
        </div>
      </div>
    </section>

    {(snaps.length > 1 || history.changes.length > 0) && (
      <section aria-labelledby="changes-h">
        <h2 id="changes-h">Recent changes</h2>
        <p class="meta">How the statuses moved. Also as <a href="/roadmap-changes.xml">RSS</a> and <a href="/roadmap-changes.json">JSON</a>; the whole roadmap is <a href="/roadmap.json">roadmap.json</a>.</p>
        {snaps.length > 1 && (
          <figure class="hist">
            <svg viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="Share of systems in each status, per day the roadmap changed">
              {snaps.map((s, i) => {
                const total = order.reduce((n, k) => n + (s.counts[k] ?? 0), 0) || 1;
                let y = chartH;
                return (
                  <g class="hbar" transform={`translate(${i * (barW + barGap)} 0)`}>
                    <title>{`${s.date}: ${order.map((k) => `${s.counts[k] ?? 0} ${statuses[k].label.toLowerCase()}`).join(', ')}`}</title>
                    {order.map((k) => {
                      const h = ((s.counts[k] ?? 0) / total) * chartH;
                      y -= h;
                      return h > 0 && <rect class={`st-${k}`} x="0" y={y + 1} width={barW} height={Math.max(0, h - 2)} />;
                    })}
                  </g>
                );
              })}
            </svg>
            <figcaption class="legend">
              {order.map((k) => <span><i class={`st-${k}`}></i>{statuses[k].label}</span>)}
              <span class="meta">{snaps[0].date} to {snaps[snaps.length - 1].date}</span>
            </figcaption>
          </figure>
        )}
        {history.changes.length > 0 && (
          <ul class="fixlist">
            {history.changes.slice(0, 15).map((c) => (
              <li><span class="tag">{c.date}</span><span><a href={`#${c.id}`}>{c.system}</a>: {c.from === null ? `added as ${statusLabel(c.to)}` : `${statusLabel(c.from)} to ${statusLabel(c.to)}`}</span></li>
            ))}
          </ul>
        )}
      </section>
    )}
    </div>
  </div>
  <dialog class="repdlg" data-config={reportConfig}>
    <form method="dialog">
      <h3>Report: <span class="rname"></span></h3>
      <fieldset class="verdict">
        <label><input type="radio" name="verdict" value="works" /> Works for me</label>
        <label><input type="radio" name="verdict" value="broken" /> Broken</label>
      </fieldset>
      <label>Build
        <select name="build">{reportBuilds.map((b) => <option value={b}>{b}</option>)}<option value="other">Other or self-built</option></select>
      </label>
      <label>Platform
        <select name="platform"><option value="win">Windows</option><option value="linux">Linux</option><option value="mac">macOS</option><option value="proton">Proton</option></select>
      </label>
      <label class="inline"><input type="checkbox" name="modded" /> Playing with mods</label>
      <label>What you did or saw <span class="opt">(optional for Works)</span>
        <input name="note" maxlength="300" autocomplete="off" />
      </label>
      <div class="ts"></div>
      <p class="rstatus" role="status"></p>
      <div class="actions">
        <button type="submit" value="cancel" formnovalidate>Cancel</button>
        <button type="button" class="send">Send report</button>
      </div>
      <p class="meta small">Stored: the row, your answers and a salted hash of your IP to count distinct people. Bugs with steps belong in a <a href="https://github.com/VlcekM/MeitouClient/issues/new/choose">GitHub issue</a>.</p>
    </form>
  </dialog>
  <a class="totop" href="#top" aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 14l6-6 6 6" /></svg>
    <span>Top</span>
  </a>
</Base>

<script is:inline>
  // Backdrop: a random screenshot at load, then a different one every 20 s, cross-faded (not while the tab is hidden).
  (() => {
    const box = document.querySelector('.backdrop'), bgs = JSON.parse(box.dataset.bgs), layers = box.children;
    let cur = Math.floor(Math.random() * bgs.length), front = 0;
    layers[0].style.backgroundImage = `url(${bgs[cur]})`;
    layers[0].classList.add('on');
    setInterval(() => {
      if (document.hidden) return;
      let next = Math.floor(Math.random() * (bgs.length - 1)); if (next >= cur) next++;
      const img = new Image();
      img.onload = () => {
        const back = layers[1 - front];
        back.style.backgroundImage = `url(${bgs[next]})`;
        back.classList.add('on'); layers[front].classList.remove('on');
        front = 1 - front; cur = next;
      };
      img.src = bgs[next];
    }, 20000);
  })();

  // Sticky column: when taller than the window, stick by its bottom edge (a negative top), so it scrolls with the page
  // instead of inside itself.
  (() => {
    const side = document.querySelector('.side');
    const fit = () => side.style.setProperty('--side-top', `${Math.min(16, innerHeight - side.offsetHeight - 16)}px`);
    new ResizeObserver(fit).observe(side);
    addEventListener('resize', fit);
    fit();
  })();

  // Back to top: shown once the page is scrolled past the first screen; smooth unless reduced motion is asked for.
  (() => {
    const btn = document.querySelector('.totop');
    const toggle = () => { btn.hidden = scrollY < innerHeight; };
    addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', location.pathname + location.search);
    });
  })();

  // Filters: one status at a time (click again to clear), one platform, and systems with known bugs. Counts and bars follow the platform.
  (() => {
    const ORDER = ['works', 'untested', 'wip', 'bug', 'missing'];
    const LABEL = { works: 'Works', untested: 'Untested', wip: 'WIP', bug: 'Bug', missing: 'Missing', na: 'N/A' };
    const PLAT = { win: 'Windows', linux: 'Linux', mac: 'macOS' };
    let active = null, plat = 'all', onlyBugs = false, query = '';
    const search = document.querySelector('.search');
    search.hidden = false;
    const filt = document.querySelector('.filt'), filters = document.querySelector('.filters');
    // Search text per row: the system, its note and evidence (not the report buttons).
    const textOf = (tr) => [tr.querySelector('.sys').textContent, ...[...tr.querySelector('.note').childNodes].filter((n) => !n.classList?.contains('rep')).map((n) => n.textContent)].join(' ').toLowerCase();
    const rows = [...document.querySelectorAll('tr[data-row]')].map((tr) => ({ tr, text: textOf(tr), ...JSON.parse(tr.dataset.row) }));
    const on = (r) => plat === 'all' ? true : plat === 'specific' ? r.d : r.p[plat] !== 'na';
    const st = (r) => (plat in PLAT ? r.p[plat] : r.s);
    const bar = (el, rs) => { const n = rs.length; el.querySelectorAll('span').forEach((s, i) => { s.style.width = n ? `${(100 * rs.filter((r) => st(r) === ORDER[i]).length) / n}%` : '0'; }); };
    const note = document.querySelector('.filter-note'), clear = note.querySelector('.clear');
    function apply() {
      const vis = rows.filter(on);
      document.querySelectorAll('.tile').forEach((t) => {
        t.querySelector('.n').textContent = vis.filter((r) => st(r) === t.dataset.s).length;
        t.setAttribute('aria-pressed', String(t.dataset.s === active));
      });
      document.querySelector('.tiles').classList.toggle('filtering', !!active);
      document.querySelectorAll('.chip[data-p]').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.p === plat)));
      document.querySelector('[data-bugs]').setAttribute('aria-pressed', String(onlyBugs));
      const left = [];
      document.querySelectorAll('.stage[id]:not(#bugs)').forEach((sec) => {
        const rs = rows.filter((r) => sec.contains(r.tr)), shown = rs.filter(on);
        bar(document.querySelector(`[data-bar="${sec.id}"]`), shown);
        sec.querySelector('[data-sum]').textContent = shown.length
          ? ORDER.map((k) => [k, shown.filter((r) => st(r) === k).length]).filter(([, n]) => n).map(([k, n]) => `${n} ${LABEL[k].toLowerCase()}`).join(' · ')
          : 'nothing for this platform';
        let any = false;
        rs.forEach((r) => {
          const s = on(r) ? st(r) : r.s, show = on(r) && (!active || s === active) && (!onlyBugs || r.b) && (!query || r.text.includes(query));
          const pill = r.tr.querySelector('.pill'); pill.className = `pill st-${s}`; pill.textContent = LABEL[s];
          r.tr.hidden = !show; any ||= show;
        });
        sec.hidden = !any;
        if (!any) left.push(sec.querySelector('h2').textContent);
      });
      // Categories with nothing to show are left out, and named in one line after the rest.
      const empty = document.querySelector('.empty-cats');
      empty.textContent = left.length === document.querySelectorAll('.stage[id]:not(#bugs)').length
        ? 'No rows match the filters.' : `No rows match the filters in: ${left.join(', ')}.`;
      empty.hidden = !left.length;
      const parts = [];
      if (plat !== 'all') parts.push(plat === 'specific' ? 'rows whose status differs by platform' : `the status on ${PLAT[plat]}`);
      if (active) parts.push(`${LABEL[active]} only`);
      if (onlyBugs) parts.push('systems with known bugs');
      if (query) parts.push(`systems matching “${search.value.trim()}”`);
      note.firstChild.textContent = `Showing ${parts.join(', ')}. `;
      note.hidden = !parts.length;
      const n = (plat !== 'all') + onlyBugs + !!query, fc = filt.querySelector('.fc');
      fc.textContent = n; fc.hidden = !n;
      // The filters live in the query string (defaults left out), so a filtered view can be linked; the #row anchor stays.
      const qs = new URLSearchParams();
      if (active) qs.set('status', active);
      if (plat !== 'all') qs.set('platform', plat);
      if (onlyBugs) qs.set('bugs', '1');
      if (search.value.trim()) qs.set('q', search.value.trim());
      const url = location.pathname + (qs.size ? `?${qs}` : '') + location.hash;
      if (url !== location.pathname + location.search + location.hash) history.replaceState(null, '', url);
    }
    const given = new URLSearchParams(location.search), PLATS = ['all', 'specific', ...Object.keys(PLAT)];
    if (ORDER.includes(given.get('status'))) active = given.get('status');
    if (PLATS.includes(given.get('platform'))) plat = given.get('platform');
    onlyBugs = given.get('bugs') === '1';
    search.value = given.get('q') ?? '';
    query = search.value.trim().toLowerCase();
    document.querySelector('.tiles').addEventListener('click', (e) => { const t = e.target.closest('.tile'); if (!t) return; active = active === t.dataset.s ? null : t.dataset.s; apply(); });
    document.querySelector('.plats').addEventListener('click', (e) => {
      const c = e.target.closest('.chip'); if (!c) return;
      if (c.hasAttribute('data-bugs')) onlyBugs = !onlyBugs; else plat = c.dataset.p;
      apply();
    });
    search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); });
    clear.addEventListener('click', () => { active = null; plat = 'all'; onlyBugs = false; query = search.value = ''; apply(); });
    // Platform, bug and search filters fold away behind the Filter button; open at load when one of them is set.
    filt.hidden = false;
    const fold = (open) => { filt.setAttribute('aria-expanded', String(open)); filters.classList.toggle('shut', !open); filters.inert = !open; };
    filt.addEventListener('click', () => fold(filters.classList.contains('shut')));
    fold(plat !== 'all' || onlyBugs || !!query);
    filters.offsetHeight; filters.classList.add('anim');
    apply();
  })();

  // Play reports: counts per row from the reports service, and a Works for me / Broken form. Hidden when the service is not set or down.
  (() => {
    const dlg = document.querySelector('.repdlg'), cfg = JSON.parse(dlg.dataset.config);
    if (!cfg.url) return;
    const form = dlg.querySelector('form'), status = dlg.querySelector('.rstatus'), send = dlg.querySelector('.send');
    let row = null, widget = null;
    const show = (summary) => {
      const by = Object.fromEntries(summary.rows.map((s) => [s.row, s]));
      document.querySelectorAll('[data-rep]').forEach((el) => {
        const s = by[el.dataset.rep];
        el.querySelector('.rc').textContent = s ? `${s.works} works, ${s.broken} broken, last on ${s.lastBuild}` : 'No reports yet';
        el.hidden = false;
      });
    };
    const load = (fresh) => fetch(`${cfg.url}/summary`, fresh ? { cache: 'reload' } : {}).then((r) => (r.ok ? r.json() : Promise.reject())).then(show);
    load().catch(() => {});

    // Turnstile is loaded on the first open only, so a visitor who never reports never loads it.
    const turnstile = () => new Promise((resolve) => {
      if (!cfg.siteKey) return resolve();
      if (window.turnstile) return resolve();
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.onload = () => resolve(); s.onerror = () => resolve();
      document.head.append(s);
    });
    const guessPlatform = () => /Mac/.test(navigator.platform) ? 'mac' : /Linux/.test(navigator.platform) ? 'linux' : 'win';

    document.addEventListener('click', async (e) => {
      const b = e.target.closest('[data-rep] button'); if (!b) return;
      const el = b.closest('[data-rep]');
      row = el.dataset.rep;
      dlg.querySelector('.rname').textContent = el.dataset.name;
      form.reset();
      form.verdict.value = b.dataset.v;
      form.platform.value = guessPlatform();
      status.textContent = ''; send.disabled = false;
      dlg.showModal();
      await turnstile();
      if (cfg.siteKey && window.turnstile) {
        if (widget === null) widget = window.turnstile.render(dlg.querySelector('.ts'), { sitekey: cfg.siteKey, theme: 'dark' });
        else window.turnstile.reset(widget);
      }
    });

    send.addEventListener('click', async () => {
      const verdict = form.verdict.value, note = form.note.value.trim();
      if (verdict === 'broken' && !note) { status.textContent = 'Say what happened.'; form.note.focus(); return; }
      send.disabled = true; status.textContent = 'Sending…';
      const body = {
        row, verdict, note, build: form.build.value, platform: form.platform.value, modded: form.modded.checked, source: 'web',
        turnstile: widget !== null && window.turnstile ? window.turnstile.getResponse(widget) : undefined,
      };
      try {
        const r = await fetch(`${cfg.url}/reports`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (r.status === 429) throw new Error('Too many reports from here; try again later.');
        const res = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(res.error ? `Not sent: ${res.error}.` : 'Not sent.');
        status.textContent = 'Thanks, recorded.';
        load(true).catch(() => {});
        setTimeout(() => dlg.close(), 900);
      } catch (err) {
        status.textContent = err.message || 'Not sent; the report service did not answer.';
        send.disabled = false;
        if (widget !== null && window.turnstile) window.turnstile.reset(widget);
      }
    });
  })();
</script>

