---
import '@fontsource/exo-2/400.css';
import '@fontsource/exo-2/600.css';
import '../styles/meitou.css';
import DiscordIcon from '../components/DiscordIcon.astro';
import GithubIcon from '../components/GithubIcon.astro';
import KofiIcon from '../components/KofiIcon.astro';
import KofiOverlay from '../components/KofiOverlay.astro';
import LicenseLink from '../components/LicenseLink.astro';
import PageJumps from '../components/PageJumps.astro';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  description?: string;
  /** Ko-fi as a button at the top centre instead of the floating widget at the bottom left. */
  kofiTop?: boolean;
  /** The homepage hero displays the wordmark over its opening video. */
  video?: boolean;
}

const { title, description = 'MeitouClient: a .NET reimplementation of the Kenshi engine.', video = false, kofiTop = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="mt-scene">
      {video && (
        <div class="bg" aria-hidden="true">
          <video autoplay muted loop playsinline preload="auto" poster="/bgvideo.jpg">
            <source src="/bgvideo.webm" type="video/webm" />
          </video>
        </div>
      )}
      <header id="top" tabindex="-1" class:list={['top', { 'is-over': video }]}>
        {!video && <Wordmark class="brand" />}
        <nav class="site-links" aria-label="Site navigation">
          <a class="mt-link-button" href="/roadmap">Roadmap</a>
          <a class="mt-link-button" href="/benchmarks">Benchmarks</a>
          <a class="mt-link-button" href="https://discord.gg/DVAHH2n9DR"><DiscordIcon /> Discord</a>
          <a class="mt-link-button" href="https://github.com/VlcekM/MeitouClient"><GithubIcon /> GitHub</a>
        </nav>
        {kofiTop && (
          <div class="center">
            <a class="kofi" href="https://ko-fi.com/martinvlcek" title="It supports me in the development of Meitou."><KofiIcon />Support me on Ko-fi</a>
            <slot name="center" />
          </div>
        )}
      </header>
      <main>
        <slot />
      </main>
      <footer id="bottom" tabindex="-1" class="foot mt-caption">
        <LicenseLink /> · No game assets are distributed · Not affiliated with Lo-Fi Games
      </footer>
    </div>
    <PageJumps />
    {!kofiTop && <KofiOverlay />}
    {video && (
      <script is:inline>
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('.bg video')?.pause();
      </script>
    )}
  </body>
</html>

<style>
  /* --frame: the page ground around the video; --edge: where content starts, just inside the frame. */
  .mt-scene { --frame: 36px; --edge: calc(var(--frame) + 24px); }


  /* First view: the video in a frame with rounded inner corners, behind the header and hero. */
  .bg {
    position: absolute;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    height: calc(100svh - 2 * var(--frame));
    overflow: hidden;
    border-radius: calc(4 * var(--radius-card));
    pointer-events: none;
  }
  .bg video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Slight vignette: darker corners, a band behind the header, a soft patch behind the hero text. */
  .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 760px 380px at 16% 12%, rgba(8, 6, 5, .55), transparent 70%),
      linear-gradient(rgba(8, 6, 5, .45), transparent 120px),
      radial-gradient(ellipse at center, transparent 55%, rgba(8, 6, 5, .5) 100%);
  }
  .top, main, .foot { position: relative; }
  .top {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    flex-wrap: wrap;
    justify-content: flex-end;
    padding: var(--edge);
  }
  /* On the video page the hero title takes the top left; the links float at the top right. */
  .top.is-over { position: absolute; inset: 0 0 auto; z-index: 1; pointer-events: none; }
  .top.is-over a { pointer-events: auto; }
  .brand { margin-right: auto; }
  .site-links { display: flex; gap: var(--space-4); }
  /* Ko-fi button and a page's own note, centred in the header bar on wide screens, on a line of their own below that. */
  .center { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; flex-basis: 100%; gap: var(--space-6); color: var(--main); font: 400 14px/18px var(--font-exo); }
  /* Ko-fi's own button in white, as in the launcher. */
  .kofi { display: inline-flex; align-items: center; gap: var(--space-4); padding: 5px 12px; border-radius: var(--radius-card); background: #fff; color: #000; font: 600 13px/18px var(--font-exo); text-decoration: none; box-shadow: 0 1px 3px rgba(0, 0, 0, .8); transition: background .16s ease; }
  .kofi:hover { background: #ebebeb; color: #000; }
  .kofi:active { background: #d9d9d9; box-shadow: none; }
  @media (min-width: 1240px) {
    .top:has(.center) { display: grid; grid-template-columns: minmax(max-content, 1fr) auto minmax(max-content, 1fr); }
    .center { grid-area: 1 / 2; flex-wrap: nowrap; }
    .top:has(.center) .site-links { grid-area: 1 / 3; justify-self: end; }
  }
  @media (max-width: 800px) {
    .top { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: var(--space-5); }
    .brand { margin: 0; }
  }
  main { padding: 0 var(--edge); }
  .foot { padding: var(--space-7) var(--edge) 36px; text-align: center; }

  /* On phones the video fills the first view. A darker scrim keeps its text readable. */
  @media (max-width: 640px) {
    .mt-scene { --frame: 0px; --edge: 20px; }
    .bg { border-radius: 0; }
    .bg::after {
      background:
        linear-gradient(rgba(8, 6, 5, .7), rgba(8, 6, 5, .3) 45%, rgba(8, 6, 5, .65)),
        radial-gradient(ellipse at center, transparent 55%, rgba(8, 6, 5, .5) 100%);
    }
    .top { padding: var(--space-4) var(--edge); }
    .site-links { display: grid; grid-template-columns: repeat(4, auto); gap: var(--space-2); width: min(100%, 27rem); }
    .site-links a { min-height: 44px; padding: 4px 3px; gap: var(--space-2); font-size: 14px; }
    .site-links :global(svg) { width: 16px; height: 16px; }
    .center { gap: var(--space-3) var(--space-5); }
    /* Room below the license for the fixed page jumps and support button. */
    .foot { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
  }

  /* At the narrowest widths the four links form two even rows above the introduction. */
  @media (max-width: 359px) {
    .mt-scene { --hero-nav-inset: 112px; }
    .site-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* At high zoom or in landscape, let the header take the space its links need. */
  @media (max-height: 600px) {
    .top.is-over { position: relative; padding-block: var(--space-5); }
  }
</style>
