<Project>

  <PropertyGroup>
    <!-- Explicit compatibility builds keep Ventura-only Macs on .NET 10; standard builds use .NET 11. -->
    <MeitouTargetFramework Condition="'$(MeitouTargetFramework)' == '' and '$(MeitouLegacyMac)' == 'true'">net10.0</MeitouTargetFramework>
    <MeitouTargetFramework Condition="'$(MeitouTargetFramework)' == ''">net11.0</MeitouTargetFramework>
    <TargetFramework>$(MeitouTargetFramework)</TargetFramework>
    <AppleMinOSVersion Condition="'$(MeitouLegacyMac)' == 'true'">13.0</AppleMinOSVersion>
    <DefineConstants Condition="'$(MeitouLegacyMac)' == 'true'">$(DefineConstants);MEITOU_LEGACY_MAC</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The .editorconfig rules raised to warning (naming, IDE1006) are checked by the build too, not only by the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>MeitouClient</Product>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- The Metal backend (src/Meitou.Game/Rendering/Metal) compiles on macOS only (SharpMetal P/Invokes libobjc); -p:MeitouMetal=true compiles it elsewhere. -->
    <MeitouMetal Condition="'$(MeitouMetal)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</MeitouMetal>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MeitouMetal)' == 'true'">
    <DefineConstants>$(DefineConstants);MEITOU_METAL</DefineConstants>
  </PropertyGroup>

</Project>
