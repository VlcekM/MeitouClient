<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proving Grounds for Meitou (docs/formats/rekenshi.md "Ports"): roscatoday's C# port of Shutori's RE_Kenshi plugin Proving Grounds,
       shipped with the game by the author's leave. Core/ is the game-free logic, src/ the Meitou glue; README.md names the source commit. -->
  <PropertyGroup>
    <AssemblyName>ProvingGroundsMeitou</AssemblyName>
    <RootNamespace>ProvingGrounds</RootNamespace>
    <PortId>ProvingGroundsMeitou</PortId>
    <!-- ScreenHost.ViewForCheck is set by the author's offline check program (not imported) through reflection. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The build's local date and time for the start line (the original wrote __DATE__ " " __TIME__). -->
    <AssemblyMetadata Include="BuildStamp" Value="$([System.DateTime]::Now.ToString('yyyy-MM-ddTHH:mm:ss'))" />
  </ItemGroup>

</Project>
