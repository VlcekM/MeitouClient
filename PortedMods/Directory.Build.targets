<Project>

  <!-- Official ports of RE_Kenshi plugins (docs/formats/rekenshi.md "Ports"): each folder here is one code mod project setting PortId (its
       meitou.json id) with its meitou.json beside it. It builds against the game, which supplies every Meitou assembly, and its DLL and
       manifest go to PortedMods/<PortId> beside the game: the Debug or Release build's output, or MeitouPortsDir (the release zip's stage). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <MeitouPortsDir Condition="'$(MeitouPortsDir)' == ''">$(MSBuildThisFileDirectory)../src/Meitou.Game/bin/$(Configuration)/$(TargetFramework)/PortedMods/</MeitouPortsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyPortBesideGame" AfterTargets="Build">
    <Error Condition="'$(PortId)' == ''" Text="A port sets PortId, the id in its meitou.json (docs/formats/rekenshi.md &quot;Ports&quot;)." />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/meitou.json"
          DestinationFolder="$([MSBuild]::EnsureTrailingSlash('$(MeitouPortsDir)'))$(PortId)" SkipUnchangedFiles="true" />
  </Target>

</Project>
